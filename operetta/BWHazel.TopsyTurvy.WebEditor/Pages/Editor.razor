@page "/"

@implements IDisposable

@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<div class="editor-root">
    <MudPaper Elevation="1" Square="true" Class="flex-shrink-0">
        <MudToolBar Dense="true" Class="editor-toolbar">
            <MudButton Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.CreateNewFolder"
                       OnClick="this.ConfirmNewAsync">@(this.areGsLabelsEnabled ? "Mount" : "New Project")</MudButton>
            <MudButton Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.InsertDriveFile"
                       OnClick="this.NewFileAsync">@(this.areGsLabelsEnabled ? "Commission" : "New File")</MudButton>
            <MudButton Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.FolderOpen"
                       OnClick="this.OpenFileAsync">@(this.areGsLabelsEnabled ? "Recall" : "Open")</MudButton>
            <MudButton Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Save"
                       OnClick="this.SaveFileAsync">@(this.areGsLabelsEnabled ? "Pen" : "Save")</MudButton>
            <MudSpacer />
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       Disabled="isRunning"
                       OnClick="this.RunProgramAsync">@(this.areGsLabelsEnabled ? "Perform" : "Run")</MudButton>
            <MudSpacer />
            <MudButton Size="Size.Small"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Outlined.DeleteOutline"
                       OnClick="this.ConfirmClearAsync">Clear Output</MudButton>
            <MudButton Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.FileDownload"
                       OnClick="this.DownloadTerminalAsync">Download Output</MudButton>
            <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
            <MudButton Size="Size.Small"
                       StartIcon="@(IsDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                       OnClick="this.OnToggleDarkMode">@(IsDarkMode ? "Light Mode" : "Dark Mode")</MudButton>
            <MudSwitch T="bool"
                       Value="this.areGsLabelsEnabled"
                       ValueChanged="this.OnGsLabelsToggledAsync"
                       Label="G&amp;S Labels"
                       Color="Color.Primary"
                       Class="mr-1" />
        </MudToolBar>
    </MudPaper>

    <div class="tab-bar-row">
        <MudTabs ActivePanelIndex="@this.ActiveTabIndex"
                 ActivePanelIndexChanged="this.OnTabIndexChangedAsync"
                 AlwaysShowScrollButtons="true"
                 Color="Color.Default"
                 Rounded="true"
                 Class="flex-1 min-width-0 tab-bar-tabs">
            @foreach (VirtualFile file in this.files)
            {
                <MudTabPanel Tag="@file.Name" PanelClass="d-none">
                    <TabContent>
                        <div class="d-flex align-center">
                            <span class="tab-filename">@file.Name</span>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                          Size="Size.Small"
                                          Class="tab-close-btn"
                                          OnClick="@(() => this.CloseFileAsync(file.Name))" />
                        </div>
                    </TabContent>
                </MudTabPanel>
            }
        </MudTabs>
    </div>

    <div class="panes-container">
        <div class="editor-pane">
            <div class="editor-content-area">
                <div style="@(this.activeEditorMode == EditorMode.Code ? "height:100%" : "display:none;height:100%")">
                    <TopsyTurvyCodeEditor @ref="this.codeEditor"
                                     Id="topsy-turvy-editor"
                                     CssClass="topsy-turvy-monaco"
                                     ConstructionOptions="this.GetEditorOptions"
                                     OnDidChangeModelContent="this.OnContentChangedAsync" />
                </div>
                @if (this.visualTabEverActivated)
                {
                    <div style="@(this.activeEditorMode == EditorMode.Visual ? "height:100%;position:relative" : "display:none;height:100%")">
                        <VisualEditor Diagram="this.visualDiagram"
                                      IsReadOnly="this.isVisualReadOnly"
                                      OnNodeChanged="this.OnVisualNodeChangedAsync"
                                      IsPanelOpen="this.isSymbolPanelOpen"
                                      VisualSymbols="this.visualSymbols"
                                      OnToggleReadOnly="this.ToggleVisualReadOnlyAsync"
                                      OnTogglePanelOpen="@(() => { this.isSymbolPanelOpen = !this.isSymbolPanelOpen; this.StateHasChanged(); })" />
                        @if (this.visualGraphHasErrors)
                        {
                            <div class="visual-graph-error-overlay" title="The graph is not currently parseable. Connect all required ports to update the code editor.">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Large" />
                                <span>Programme contains errors: please check values and connect all required ports.</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <MudTabs ActivePanelIndex="@((int)this.activeEditorMode)"
                     ActivePanelIndexChanged="this.OnEditorModeChangedAsync"
                     Class="editor-mode-tabs"
                     Color="Color.Default"
                     Rounded="false">
                <MudTabPanel Text="@(this.areGsLabelsEnabled ? "Libretto" : "Code")" PanelClass="d-none" />
                <MudTabPanel Text="@(this.areGsLabelsEnabled ? "Stage (Experimental)" : "Visual (Experimental)")" PanelClass="d-none" />
            </MudTabs>
        </div>
        <div class="pane-divider"></div>
        <div class="output-pane">
            <div class="terminal-wrapper">
                <Xterm @ref="terminal" Options="this.terminalOptions" />
            </div>
            <MudTextField T="string"
                          @bind-Value="this.commandLineArgumentsText"
                          @bind-Value:after="this.SavePreferencesAsync"
                          Label="Command-Line Arguments"
                          HelperText="Space-separated"
                          Variant="Variant.Outlined"
                          Class="ma-2" />
            <MudTextField T="string"
                          @bind-Value="this.stdinText"
                          @bind-Value:after="this.SavePreferencesAsync"
                          Label="Standard Input"
                          HelperText="One value per line"
                          Lines="2"
                          Variant="Variant.Outlined"
                          Class="ma-2" />
        </div>
    </div>
</div>

@code {
    private const string DefaultFileName = "programme.topsy";

    /// <summary>
    /// Gets or sets a value indicating whether the editor is currently in dark mode.
    /// </summary>
    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; } = true;

    /// <summary>
    /// Gets or sets the callback that toggles dark mode on the root layout.
    /// </summary>
    [CascadingParameter(Name = "ToggleDarkMode")]
    private Action? ToggleDarkMode { get; set; }

    private TopsyTurvyCodeEditor? codeEditor;
    private StandaloneCodeEditor? monacoEditor => this.codeEditor?.Editor;
    private EditorMode activeEditorMode = EditorMode.Code;
    private bool visualTabEverActivated = false;
    private BlazorDiagram? visualDiagram;
    private bool isVisualReadOnly = true;
    private string lastBuiltVisualSource = string.Empty;
    private Xterm? terminal;
    private bool editorReady = false;
    private string commandLineArgumentsText = string.Empty;
    private string stdinText = string.Empty;
    private bool isRunning = false;
    private bool visualGraphHasErrors = false;
    private bool isSymbolPanelOpen = false;
    private IReadOnlyList<VisualSymbolEntry> visualSymbols = [];
    private string lastRunOutput = string.Empty;
    private bool previousIsDarkMode = true;
    private bool areGsLabelsEnabled = true;
    private DotNetObjectReference<Editor>? dotNetRef;
    private readonly Dictionary<string, SymbolTable> symbolTables = new();
    private readonly Dictionary<string, string> parsedSources = new();
    private CancellationTokenSource? cancellationTokenSource;

    private List<VirtualFile> files = [new(DefaultFileName)];
    private string activeFileName = DefaultFileName;

    private TerminalOptions terminalOptions => new()
    {
        CursorBlink = false,
        ConvertEOL = true,
        Theme = new Theme
        {
            Background = this.IsDarkMode ? "#1e1e1e" : "#f5f5f5",
            Foreground = this.IsDarkMode ? "#d4d4d4" : "#1e1e1e",
        },
    };

    /// <summary>
    /// Gets the index of the currently active tab based on the active file name.
    /// </summary>
    private int ActiveTabIndex => Math.Max(0, this.files.FindIndex(file => file.Name == this.activeFileName));

    /// <summary>
    /// Gets the symbol table for the currently active file, or <c>null</c> if not yet parsed.
    /// </summary>
    private SymbolTable? ActiveSymbolTable => this.symbolTables.GetValueOrDefault(this.activeFileName);

    /// <summary>
    /// Gets the last-parsed source text for the currently active file.
    /// </summary>
    private string ActiveParsedSource => this.parsedSources.GetValueOrDefault(this.activeFileName, string.Empty);

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            this.dotNetRef = DotNetObjectReference.Create(this);
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.applyLanguageToEditor", "topsy-turvy-editor");
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.registerHoverProvider", this.dotNetRef);
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.registerSymbolCompletionProvider", this.dotNetRef);
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.registerDefinitionProvider", this.dotNetRef);
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.registerSignatureHelpProvider", this.dotNetRef);
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.registerSemanticTokensProvider");
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.enableSemanticHighlighting", "topsy-turvy-editor");
            await this.JSRuntime.InvokeVoidAsync("monaco.editor.setTheme", this.IsDarkMode ? "topsy-turvy-dark" : "topsy-turvy-light");
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.setupTerminalFit");
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.initPaneDrag");
            await this.RestorePreferencesAsync();

            this.editorReady = true;
            this.previousIsDarkMode = IsDarkMode;
        }
    }

    /// <summary>
    /// Restores editor state from Local Storage on the initial render.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task RestorePreferencesAsync()
    {
        EditorPreferences? savedPreferences = await this.JSRuntime.InvokeAsync<EditorPreferences>("topsyTurvy.loadPreferences");
        if (savedPreferences is null)
        {
            return;
        }

        if (savedPreferences.AreGsLabelsEnabled.HasValue)
        {
            this.areGsLabelsEnabled = savedPreferences.AreGsLabelsEnabled.Value;
        }

        this.commandLineArgumentsText = savedPreferences.CommandLineArguments ?? string.Empty;
        this.stdinText = savedPreferences.StandardInput ?? string.Empty;

        if (savedPreferences.Files is { Count: > 0 })
        {
            this.files.Clear();
            foreach (VirtualFile file in savedPreferences.Files)
            {
                this.files.Add(file);
                this.BuildSymbolTableForFile(file.Name, file.Content);
            }

            this.activeFileName = savedPreferences.ActiveFile is not null
                && this.files.Any(file => file.Name == savedPreferences.ActiveFile)
                    ? savedPreferences.ActiveFile
                    : this.files[0].Name;

            VirtualFile activeFile = this.files.First(file => file.Name == this.activeFileName);
            await this.monacoEditor!.SetValue(activeFile.Content);
        }

        if (!string.IsNullOrEmpty(savedPreferences.TerminalOutput))
        {
            foreach (string line in savedPreferences.TerminalOutput.Split('\n'))
            {
                await this.terminal!.WriteLine(line);
            }

            this.lastRunOutput = savedPreferences.TerminalOutput;
        }

        if (savedPreferences.IsDarkMode.HasValue && savedPreferences.IsDarkMode.Value != this.IsDarkMode)
        {
            this.ToggleDarkMode?.Invoke();
        }

        this.StateHasChanged();
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (this.editorReady && this.IsDarkMode != this.previousIsDarkMode)
        {
            previousIsDarkMode = this.IsDarkMode;
            await this.JSRuntime.InvokeVoidAsync("monaco.editor.setTheme", this.IsDarkMode ? "topsy-turvy-dark" : "topsy-turvy-light");
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.setTerminalTheme", this.IsDarkMode);
            await this.SavePreferencesAsync();
        }
    }

    /// <summary>
    /// Gets the options for the Monaco editor.
    /// </summary>
    /// <param name="editor">The Monaco editor.</param>
    /// <returns>Options for the Monaco editor.</returns>
    private StandaloneEditorConstructionOptions GetEditorOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions()
        {
            Language = "topsy-turvy",
            Theme = this.IsDarkMode
                ? "vs-dark"
                : "vs",
            AutomaticLayout = true,
            AutoIndent = "full",
            Value = string.Empty,
        };
    }

    /// <summary>
    /// Toggles between light and dark mode.
    /// </summary>
    private void OnToggleDarkMode() => this.ToggleDarkMode?.Invoke();

    /// <summary>
    /// Handles a tab index change from the tab bar.
    /// </summary>
    /// <param name="index">The new zero-based active tab index.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task OnTabIndexChangedAsync(int index)
    {
        if (index >= 0 && index < this.files.Count)
        {
            string name = this.files[index].Name;
            if (name != this.activeFileName)
            {
                await this.SwitchFileAsync(name);
            }
        }
    }

    /// <summary>
    /// Handles content changes in the editor.
    /// </summary>
    /// <param name="e">The event data for the content change.</param>
    /// <remarks>
    /// Includes a pause to avoid excessive parsing.
    /// </remarks>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task OnContentChangedAsync(ModelContentChangedEvent e)
    {
        this.cancellationTokenSource?.Cancel();
        this.cancellationTokenSource = new CancellationTokenSource();
        CancellationToken token = this.cancellationTokenSource.Token;

        try
        {
            await Task.Delay(400, token);
            string source = await this.JSRuntime.InvokeAsync<string>("blazorMonaco.editor.getValue", "topsy-turvy-editor", false, null);

            VirtualFile? activeFile = this.files.Find(file => file.Name == this.activeFileName);
            if (activeFile is not null)
            {
                activeFile.Content = source;
            }

            await this.UpdateDiagnosticsAsync(source);

            // If the content matches what the visual editor just generated, this is a visual-driven
            // update: skip invalidating the cache to prevent `RebuildVisualGraphAsync` from erasing
            // any unsaved factory nodes that are not yet part of the AST.
            if (source == this.lastBuiltVisualSource)
            {
                await this.SavePreferencesAsync();
                return;
            }

            // Invalidate the visual graph cache so the next switch to the Visual tab rebuilds it.
            this.lastBuiltVisualSource = string.Empty;
            if (this.activeEditorMode == EditorMode.Visual)
            {
                await this.RebuildVisualGraphAsync();
            }

            await this.SavePreferencesAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <summary>
    /// Handles switching between the Code and Visual editor mode tabs.
    /// </summary>
    /// <param name="index">The newly selected tab index matching <see cref="EditorMode"/>.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task OnEditorModeChangedAsync(int index)
    {
        this.activeEditorMode = (EditorMode)index;

        if (this.activeEditorMode == EditorMode.Visual)
        {
            this.visualTabEverActivated = true;
            await this.RebuildVisualGraphAsync();
        }
    }

    /// <summary>
    /// Re-parses the active file and rebuilds the visual diagram from the resulting AST,
    /// skipping the rebuild if the source text has not changed since the last build.
    /// </summary>
    private async Task RebuildVisualGraphAsync()
    {
        string source = await this.JSRuntime.InvokeAsync<string>("blazorMonaco.editor.getValue", "topsy-turvy-editor", false, null);
        if (source == this.lastBuiltVisualSource && this.visualDiagram is not null)
        {
            return;
        }

        TopsyTurvyParser parser = new();
        ParseResult result = parser.TryParse(source);
        if (result.Program is not null)
        {
            VisualGraphBuilder builder = new();
            this.visualDiagram = builder.Build(result.Program, this.isVisualReadOnly);
            this.lastBuiltVisualSource = source;
            this.visualSymbols = VisualSymbolScanner.Scan(this.visualDiagram);
        }
        else
        {
            this.visualDiagram = null;
            this.lastBuiltVisualSource = string.Empty;
            this.visualSymbols = [];
        }

        this.StateHasChanged();
    }

    /// <summary>
    /// Toggles the visual editor between read-only and edit modes and rebuilds the diagram.
    /// </summary>
    private async Task ToggleVisualReadOnlyAsync()
    {
        // When locking, sync Monaco from the current visual diagram first so connected
        // factory nodes that updated the graph are not lost when the diagram rebuilds.
        if (this.isVisualReadOnly == false && this.visualDiagram is not null && !this.visualGraphHasErrors)
        {
            await this.OnVisualNodeChangedAsync();
        }

        this.isVisualReadOnly = !this.isVisualReadOnly;
        this.lastBuiltVisualSource = string.Empty;
        await this.RebuildVisualGraphAsync();
    }

    /// <summary>
    /// Regenerates the Monaco editor source from the current visual diagram state and updates diagnostics.
    /// </summary>
    /// <remarks>If the generated source is not parseable the Monaco editor is not updated and a warning icon is shown.</remarks>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task OnVisualNodeChangedAsync()
    {
        if (this.visualDiagram is null)
        {
            return;
        }

        VisualGraphToAstConverter converter = new();
        ProgramNode program = converter.Convert(this.visualDiagram);

        TopsyTurvyCodeGenerator generator = new();
        string source;
        try
        {
            source = generator.Generate(program);
        }
        catch
        {
            this.visualGraphHasErrors = true;
            this.StateHasChanged();
            return;
        }

        TopsyTurvyParser parser = new();
        ParseResult parseResult = parser.TryParse(source);

        if (!parseResult.Success)
        {
            this.visualGraphHasErrors = true;
            this.StateHasChanged();
            return;
        }

        this.visualGraphHasErrors = false;
        this.lastBuiltVisualSource = source;
        this.visualSymbols = [.. VisualSymbolScanner.Scan(this.visualDiagram), .. this.GetImportedFunctionSymbols(this.visualDiagram)];

        await this.JSRuntime.InvokeVoidAsync("blazorMonaco.editor.setValue", "topsy-turvy-editor", source);
        await this.UpdateDiagnosticsAsync(source);
        await this.SavePreferencesAsync();
    }

    /// <summary>
    /// Gets any defined functions from imported files referenced in the visual diagram.
    /// </summary>
    /// <param name="diagram">The visual diagram to scan for import nodes.</param>
    /// <returns>A list of visual symbol entries representing the functions defined in the imported files.</returns>
    private IReadOnlyList<VisualSymbolEntry> GetImportedFunctionSymbols(BlazorDiagram diagram)
    {
        List<VisualSymbolEntry> symbols = [];
        TopsyTurvyParser importParser = new();

        foreach (TopsyTurvyVisualNodeModel visualNode in diagram.Nodes.OfType<TopsyTurvyVisualNodeModel>())
        {
            if (visualNode.StatementType != "ImportNode")
            {
                continue;
            }

            string? filePath = visualNode.SymbolIdentifierNodeName;
            if (string.IsNullOrWhiteSpace(filePath))
            {
                continue;
            }

            VirtualFile? file = this.files.Find(file =>
                file.Name.Equals(filePath, StringComparison.OrdinalIgnoreCase) ||
                file.Name.Equals(filePath + ".topsy", StringComparison.OrdinalIgnoreCase));
            
            if (file is null)
            {
                continue;
            }

            ParseResult parseResult = importParser.TryParse(file.Content);
            if (parseResult.Program is null)
            {
                continue;
            }

            foreach (Statement statement in parseResult.Program.Statements)
            {
                if (statement is not FunctionDefinitionNode func)
                {
                    continue;
                }

                List<string> parameterNames = [.. func.Parameters.Select(parameter => parameter.Name)];
                symbols.Add(new VisualSymbolEntry(func.Name, VisualSymbolKind.Function, null, parameterNames));
            }
        }

        return symbols;
    }

    /// <summary>
    /// Updates the diagnostics in the editor based on the provided source code.
    /// </summary>
    /// <param name="source">The source code to analyze.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task UpdateDiagnosticsAsync(string source)
    {
        TopsyTurvyParser parser = new();
        ParseResult result = parser.TryParse(source);
        IEnumerable<object> deprecatedWarningMarkers = [];
        IEnumerable<object> shadowedFunctionWarningMarkers = [];

        if (result.Program is not null)
        {
            SymbolTable symbolTable = SymbolTable.Build(result.Program, source);
            IReadOnlyList<string> shadowedExternalFunctionNames = ExternalFunctionRegistrar.Register(symbolTable);
            this.symbolTables[this.activeFileName] = symbolTable;
            this.parsedSources[this.activeFileName] = source;

            string[] lines = source.Split('\n');
            IReadOnlyList<int> tokenData = this.ComputeSemanticTokenData(symbolTable, lines);
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.setSemanticTokens", tokenData);

            deprecatedWarningMarkers = symbolTable.AllSymbols()
                .Where(symbol => symbol.Documentation?.IsDeprecated == true && !symbol.Name.Contains(' '))
                .SelectMany(
                    symbol => SourceAnalyser.FindWordOccurrences(lines, symbol.Name)
                        .Where(occurrence => occurrence.Line + 1 != symbol.DefinitionLine),
                    (symbol, occurrence) => (object)new
                    {
                        startLineNumber = occurrence.Line + 1,
                        startColumn = occurrence.Character + 1,
                        endLineNumber = occurrence.Line + 1,
                        endColumn = occurrence.Character + symbol.Name.Length + 1,
                        message = string.IsNullOrWhiteSpace(symbol.Documentation?.DeprecationMessage)
                            ? $"'{symbol.Name}' is deprecated."
                            : $"'{symbol.Name}' is deprecated: {symbol.Documentation.DeprecationMessage}",
                        severity = 4,
                    });

            shadowedFunctionWarningMarkers = shadowedExternalFunctionNames
                .Where(name => symbolTable.TryGetSymbol(name, out SymbolInfo? shadowingSymbol) && shadowingSymbol is not null)
                .Select(name =>
                {
                    symbolTable.TryGetSymbol(name, out SymbolInfo? shadowingSymbol);
                    return (object)new
                    {
                        startLineNumber = shadowingSymbol!.DefinitionLine,
                        startColumn = shadowingSymbol.DefinitionColumn,
                        endLineNumber = shadowingSymbol.DefinitionLine,
                        endColumn = shadowingSymbol.DefinitionColumn + name.Length,
                        message = $"'{name}' shadows an external function of the same name from the Standard Library.",
                        severity = 4,
                    };
                });
        }

        IEnumerable<object> parseMarkers = result.Diagnostics
            .Where(diagnostic => diagnostic.Severity == DiagnosticSeverity.Error)
            .Select(diagnostic => (object)new
            {
                startLineNumber = diagnostic.Span.Start.Line,
                startColumn = diagnostic.Span.Start.Column,
                endLineNumber = diagnostic.Span.End.Line,
                endColumn = diagnostic.Span.End.Column,
                message = diagnostic.Message,
                severity = 8,
            });

        IEnumerable<object> typeMarkers = [];
        if (result.Success && result.Program is not null)
        {
            Dictionary<string, string> currentFileContents = this.files.ToDictionary(file => file.Name, file => file.Content);
            Func<string, string?> sourceFileResolver = name => currentFileContents.GetValueOrDefault(name);

            TopsyTurvyTypeChecker typeChecker = new();
            TypeCheckResult typeCheckResult = typeChecker.Check(result.Program, sourceFileResolver);
            typeMarkers = typeCheckResult.Diagnostics.Select(diagnostic => (object)new
            {
                startLineNumber = diagnostic.Span.Start.Line,
                startColumn = diagnostic.Span.Start.Column,
                endLineNumber = diagnostic.Span.End.Line,
                endColumn = diagnostic.Span.End.Column,
                message = diagnostic.Message,
                severity = diagnostic.Severity == DiagnosticSeverity.Error ? 8 : 4,
            });
        }

        IEnumerable<object> markers = parseMarkers.Concat(typeMarkers).Concat(deprecatedWarningMarkers).Concat(shadowedFunctionWarningMarkers);

        await this.JSRuntime.InvokeVoidAsync("topsyTurvy.setModelMarkers", "topsy-turvy-editor", markers);
    }

    /// <summary>
    /// Returns Markdown hover text for the symbol at the given 0-indexed line and column, or <c>null</c> if none.
    /// </summary>
    /// <param name="line">The 0-indexed line number.</param>
    /// <param name="column">The 0-indexed column number.</param>
    /// <returns>A Markdown string, or <c>null</c> if there is no recognised symbol at the position.</returns>
    /// <remarks>
    /// <see cref="SymbolTable.GetFunctionOverloads"/> is checked before <see cref="SymbolTable.TryGetSymbol"/>: a
    /// name with more than one declared overload renders just the one declared on the hovered line if the cursor
    /// is directly on a specific overload (<see cref="HoverMarkdownBuilder.Build(IReadOnlyList{SymbolInfo}, int)"/>),
    /// otherwise every overload, since <c>TryGetSymbol</c> alone only ever surfaces the first-declared overload.
    /// </remarks>
    [JSInvokable]
    public string? GetHoverMarkdown(int line, int column)
    {
        string? word = SymbolTable.ExtractWordAt(this.ActiveParsedSource, line, column);
        if (word is null)
        {
            return null;
        }

        IReadOnlyList<SymbolInfo> overloads = this.ActiveSymbolTable?.GetFunctionOverloads(word) ?? [];
        if (overloads.Count > 0)
        {
            return HoverMarkdownBuilder.Build(overloads, line);
        }

        if (this.ActiveSymbolTable?.TryGetSymbol(word, out SymbolInfo? info) == true && info is not null)
        {
            return info.Kind == SymbolKind.Namespace
                ? this.BuildNamespaceHoverMarkdown(info)
                : HoverMarkdownBuilder.Build(info);
        }

        foreach ((string fileName, SymbolTable otherTable) in this.symbolTables)
        {
            if (fileName == this.activeFileName)
            {
                continue;
            }

            IReadOnlyList<SymbolInfo> otherOverloads = otherTable.GetFunctionOverloads(word);
            if (otherOverloads.Count > 0)
            {
                return HoverMarkdownBuilder.Build(otherOverloads);
            }

            if (otherTable.TryGetSymbol(word, out SymbolInfo? otherInfo) && otherInfo is not null)
            {
                return otherInfo.Kind == SymbolKind.Namespace ? this.BuildNamespaceHoverMarkdown(otherInfo) : HoverMarkdownBuilder.Build(otherInfo);
            }
        }

        return this.TryBuildNamespaceSegmentHoverMarkdown(word);
    }

    /// <summary>
    /// Gets signature help for an in-progress <c>SUMMON</c> call at the given 0-indexed line and column, or
    /// <c>null</c> if no such call is detected.
    /// </summary>
    /// <param name="line">The 0-indexed line number.</param>
    /// <param name="column">The 0-indexed column number.</param>
    /// <returns>
    /// An anonymous object with lower-camel-case properties matching the Monaco <c>SignatureHelp</c> shape
    /// (<c>signatures</c>, each with a <c>label</c> and a <c>parameters</c> array of parameter labels;
    /// <c>activeSignature</c>; <c>activeParameter</c>), or <c>null</c> if there is no in-progress call at the
    /// position.
    /// </returns>
    /// <remarks>
    /// Delegates entirely to <see cref="SignatureHelpBuilder.Build"/>, the same resolution the LSP
    /// <c>SignatureHelpHandler</c> uses.
    /// </remarks>
    [JSInvokable]
    public object? GetSignatureHelp(int line, int column)
    {
        if (this.ActiveSymbolTable is null)
        {
            return null;
        }

        SignatureHelpResult? result = SignatureHelpBuilder.Build(this.ActiveParsedSource, line, column, this.ActiveSymbolTable);
        if (result is null)
        {
            return null;
        }

        return new
        {
            signatures = result.Signatures.Select(signature => new
            {
                label = signature.Label,
                parameters = signature.ParameterLabels
            }),
            activeSignature = result.ActiveSignature,
            activeParameter = result.ActiveParameter
        };
    }

    /// <summary>
    /// Builds namespace hover Markdown for a symbol that is itself a namespace declaration.
    /// </summary>
    /// <param name="symbolInfo">The namespace symbol; <see cref="SymbolInfo.Name"/> is the <c>*</c>-joined namespace path.</param>
    /// <remarks>
    /// Reached when the word under the cursor exactly matches the whole name of a single-segment namespace, e.g.
    /// <c>Accounts</c> in <c>TOWN Accounts</c>.  Individual segments of a multi-segment namespace go via
    /// <see cref="TryBuildNamespaceSegmentHoverMarkdown"/> instead.
    /// </remarks>
    /// <returns>Markdown for the namespace, listing its declared functions.</returns>
    private string BuildNamespaceHoverMarkdown(SymbolInfo symbolInfo)
    {
        string[] namespacePath = symbolInfo.Name.Split('*');
        return HoverMarkdownBuilder.BuildNamespaceHover(namespacePath, this.GetFunctionsInNamespace(namespacePath));
    }

    /// <summary>
    /// Builds namespace hover Markdown for a word matching a namespace path segment rather than a whole symbol.
    /// </summary>
    /// <param name="word">The word under the cursor.</param>
    /// <remarks>
    /// A namespace segment has no <see cref="SymbolInfo"/> of its own, so this is the fallback once ordinary symbol
    /// lookup fails.
    /// </remarks>
    /// <returns>Markdown for the first matching namespace, or <c>null</c> if none match.</returns>
    private string? TryBuildNamespaceSegmentHoverMarkdown(string word)
    {
        foreach (SymbolTable table in this.symbolTables.Values)
        {
            foreach (SymbolInfo symbol in table.AllSymbols())
            {
                if (symbol.Kind != SymbolKind.Namespace)
                {
                    continue;
                }

                string[] namespacePath = symbol.Name.Split('*');
                if (namespacePath.Any(segment => string.Equals(segment, word, StringComparison.OrdinalIgnoreCase)))
                {
                    return HoverMarkdownBuilder.BuildNamespaceHover(namespacePath, this.GetFunctionsInNamespace(namespacePath));
                }
            }
        }

        return null;
    }

    /// <summary>
    /// Returns the function symbols declared in every file whose own namespace path exactly matches
    /// <paramref name="namespacePath"/> (segment-by-segment, case-insensitive).
    /// </summary>
    /// <param name="namespacePath">The namespace path to match against.</param>
    /// <returns>The matching function symbols.</returns>
    private IEnumerable<SymbolInfo> GetFunctionsInNamespace(IReadOnlyList<string> namespacePath)
    {
        foreach (SymbolTable table in this.symbolTables.Values)
        {
            bool declaresNamespace = table.AllSymbols().Any(symbol =>
                symbol.Kind == SymbolKind.Namespace &&
                NamespacePathsEqual(symbol.Name.Split('*'), namespacePath));

            if (!declaresNamespace)
            {
                continue;
            }

            foreach (SymbolInfo symbol in table.AllSymbols())
            {
                if (symbol.Kind == SymbolKind.Function)
                {
                    yield return symbol;
                }
            }
        }
    }

    /// <summary>
    /// Compares two namespace paths segment-by-segment, case-insensitively.
    /// </summary>
    /// <param name="first">The first namespace path.</param>
    /// <param name="second">The second namespace path.</param>
    /// <returns><c>true</c> if both paths have the same number of segments and each segment matches case-insensitively, otherwise <c>false</c>.</returns>
    private static bool NamespacePathsEqual(IReadOnlyList<string> first, IReadOnlyList<string> second)
    {
        if (first.Count != second.Count)
        {
            return false;
        }

        for (int i = 0; i < first.Count; i++)
        {
            if (!string.Equals(first[i], second[i], StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
        }

        return true;
    }

    /// <summary>
    /// Returns completion items for all named symbols in the current symbol table.
    /// </summary>
    /// <remarks>
    /// <c>JUST SO</c> is excluded as its name contains a space and cannot be inserted as a normal identifier completion.
    /// </remarks>
    /// <returns>
    /// A list of objects with name and symbol kind.
    /// </returns>
    [JSInvokable]
    public IReadOnlyList<object> GetSymbolCompletions()
    {
        if (this.symbolTables.Count == 0)
        {
            return [];
        }

        return this.symbolTables.Values
            .SelectMany(table => table.AllSymbols())
            .GroupBy(info => info.Name, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .Where(info => !info.Name.Equals("JUST SO", StringComparison.OrdinalIgnoreCase))
            .Select(info => (object)new
            {
                name = info.Name,
                kind = info.Kind.ToString().ToLowerInvariant(),
                detail = info.Kind switch
                {
                    SymbolKind.Variable  => info.TypeDisplayName ?? string.Empty,
                    SymbolKind.Function  => $"({string.Join(", ", info.TypedParameters?.Select(static parameter => parameter.Name) ?? Array.Empty<string>())})",
                    _                    => string.Empty
                }
            })
            .ToList();
    }

    /// <summary>
    /// Returns the 1-indexed line and column of the definition for the symbol under the given 0-indexed cursor position,
    /// or <c>null</c> if no definition position is available.
    /// </summary>
    /// <param name="line">The 0-indexed line number.</param>
    /// <param name="column">The 0-indexed column number.</param>
    /// <remarks>
    /// Row and column are 1-indexed to match the Monaco coordinate system.
    /// </remarks>
    /// <returns>
    /// An object with line and column or <c>null</c> if no recognised symbol
    /// with a known definition is at the position.
    /// </returns>
    [JSInvokable]
    public object? GetDefinitionLocation(int line, int column)
    {
        string? word = SymbolTable.ExtractWordAt(this.ActiveParsedSource, line, column);
        if (word is null)
        {
            return null;
        }

        if (this.ActiveSymbolTable?.TryGetSymbol(word, out SymbolInfo? info) == true
            && info is not null && info.DefinitionLine != 0)
        {
            return new
            {
                line = info.DefinitionLine,
                column = info.DefinitionColumn,
                fileName = (string?)null
            };
        }

        foreach ((string otherFileName, SymbolTable otherTable) in this.symbolTables)
        {
            if (otherFileName == this.activeFileName)
            {
                continue;
            }

            if (otherTable.TryGetSymbol(word, out SymbolInfo? otherInfo)
                && otherInfo is not null && otherInfo.DefinitionLine != 0)
            {
                return new
                {
                    line = otherInfo.DefinitionLine,
                    column = otherInfo.DefinitionColumn,
                    fileName = otherFileName
                };
            }
        }

        return null;
    }

    /// <summary>
    /// Switches the active file to the given file name and loads its content into the Monaco editor.
    /// </summary>
    /// <remarks>
    /// Called by the JS definition provider when a symbol definition lives in a different open file.
    /// </remarks>
    /// <param name="fileName">The name of the file to switch to.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    [JSInvokable]
    public async Task SwitchToFileForDefinitionAsync(string fileName)
    {
        if (this.activeFileName == fileName || !this.files.Any(file => file.Name == fileName))
        {
            return;
        }

        await this.SyncActiveFileContentAsync();
        this.activeFileName = fileName;
        VirtualFile targetFile = this.files.First(file => file.Name == fileName);
        await this.monacoEditor!.SetValue(targetFile.Content);
        this.StateHasChanged();
    }

    /// <inheritdoc />
    public void Dispose()
    {
        this.dotNetRef?.Dispose();
    }

    /// <summary>
    /// Runs the program currently in the editor, using the text from the standard input field as input.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task RunProgramAsync()
    {
        if (this.isRunning)
        {
            return;
        }

        isRunning = true;
        try
        {
            await this.RunProgramCoreAsync();
        }
        catch (Exception ex)
        {
            await this.JSRuntime.InvokeVoidAsync("console.error", "RunError: " + ex.GetType().Name + ": " + ex.Message);
        }
        finally
        {
            this.isRunning = false;
            await this.SavePreferencesAsync();
        }
    }

    /// <summary>
    /// Core logic for running a program.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task RunProgramCoreAsync()
    {
        await this.terminal!.Clear();
        this.lastRunOutput = string.Empty;
        await this.SyncActiveFileContentAsync();

        Dictionary<string, string> currentFileContents = this.files.ToDictionary(file => file.Name, file => file.Content);
        string source = currentFileContents[this.activeFileName];
        IEnumerable<string> stdinLines = this.stdinText.Split('\n');
        string[] commandLineArguments = this.commandLineArgumentsText
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        TopsyTurvyParser parser = new();
        ParseResult parseResult = parser.TryParse(source);

        if (!parseResult.Success)
        {
            foreach (Diagnostic diagnostic in parseResult.Diagnostics
                .Where(diagnostic => diagnostic.Severity == DiagnosticSeverity.Error))
            {
                await terminal!.WriteLine($"\x1b[31mSyntax error (line {diagnostic.Span.Start.Line}): {diagnostic.Message}\x1b[0m");
            }

            return;
        }

        Func<string, string?> fileResolver = name => currentFileContents.GetValueOrDefault(name);

        TopsyTurvyTypeChecker typeChecker = new();
        TypeCheckResult typeCheckResult = typeChecker.Check(parseResult.Program!, fileResolver);
        if (!typeCheckResult.Success)
        {
            foreach (Diagnostic diagnostic in typeCheckResult.Diagnostics
                .Where(diagnostic => diagnostic.Severity == DiagnosticSeverity.Error))
            {
                await terminal!.WriteLine($"\x1b[31mType error (line {diagnostic.Span.Start.Line}): {diagnostic.Message}\x1b[0m");
            }

            return;
        }

        BufferedWebIO io = new(stdinLines);

        using CancellationTokenSource cancellationTokenSource = new(TimeSpan.FromSeconds(10));
        Interpreter interpreter = new(io);
        DiagnosticCollection runtimeDiagnostics = interpreter.Execute(
            parseResult.Program!,
            cancellationTokenSource.Token,
            options: new(TimeSpan.FromSeconds(10), null, fileResolver, commandLineArguments));

        foreach (string line in io.OutputLines)
        {
            await this.terminal!.WriteLine(line);
        }

        this.lastRunOutput = string.Join('\n', io.OutputLines);
        if (runtimeDiagnostics.HasErrors)
        {
            foreach (Diagnostic diagnostic in runtimeDiagnostics.Diagnostics
                .Where(diagnostic => diagnostic.Severity == DiagnosticSeverity.Error))
            {
                await this.terminal!.WriteLine($"\x1b[31mRuntime error: {diagnostic.Message}\x1b[0m");
            }
        }
    }

    /// <summary>
    /// Asks the user to confirm creating a new program, and if confirmed, resets the editor to a single blank file.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task ConfirmNewAsync()
    {
        bool? isNewConfirmed = await this.DialogService.ShowMessageBoxAsync(
            "Create New Programme",
            "Are you sure you want to start afresh?  This will close all files and is irreversible.",
            yesText: "Create",
            cancelText: "Cancel");

        if (isNewConfirmed == true)
        {
            this.files.Clear();
            this.symbolTables.Clear();
            this.parsedSources.Clear();
            VirtualFile newFile = new(DefaultFileName);
            this.files.Add(newFile);
            this.activeFileName = newFile.Name;
            await this.monacoEditor!.SetValue(string.Empty);
            this.StateHasChanged();
        }
    }

    /// <summary>
    /// Opens the file picker dialog and loads any selected files as new tabs.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task OpenFileAsync()
    {
        IDialogReference dialog = await this.DialogService.ShowAsync<OpenFilesDialog>("Open Files");
        DialogResult? result = await dialog.Result;

        if (result is { Canceled: false } && result.Data is IReadOnlyList<IBrowserFile> selectedFiles)
        {
            foreach (IBrowserFile browserFile in selectedFiles)
            {
                using StreamReader reader = new(browserFile.OpenReadStream(maxAllowedSize: 1_048_576));
                string content = await reader.ReadToEndAsync();
                await this.OpenSingleFileAsync(browserFile.Name, content);
            }

            this.StateHasChanged();
        }
    }

    /// <summary>
    /// Opens a single file into a new or existing tab, prompting the user if the file is already open.
    /// </summary>
    /// <param name="name">The file name.</param>
    /// <param name="content">The file content.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task OpenSingleFileAsync(string name, string content)
    {
        if (this.files.Any(file => file.Name == name))
        {
            bool? replace = await this.DialogService.ShowMessageBoxAsync(
                "File Already Open",
                $"'{name}' is already open.  Replace its content?",
                yesText: "Replace",
                cancelText: "Cancel");

            if (replace != true)
            {
                return;
            }

            VirtualFile existingFile = this.files.First(file => file.Name == name);
            existingFile.Content = content;
            if (this.activeFileName == name)
            {
                await this.monacoEditor!.SetValue(content);
            }
            else
            {
                await this.SwitchFileAsync(name);
            }

            return;
        }

        this.files.Add(new(name, content));
        this.BuildSymbolTableForFile(name, content);
        await this.SwitchFileAsync(name);
    }

    /// <summary>
    /// Saves all open files as a ZIP archive and triggers a browser download.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task SaveFileAsync()
    {
        await this.SyncActiveFileContentAsync();

        using MemoryStream memoryStream = new();
        using (ZipArchive zipArchive = new(memoryStream, ZipArchiveMode.Create, leaveOpen: true))
        {
            foreach (VirtualFile file in this.files)
            {
                ZipArchiveEntry entry = zipArchive.CreateEntry(file.Name);
                using StreamWriter writer = new(entry.Open());
                writer.Write(file.Content);
            }
        }

        string streamBase64 = Convert.ToBase64String(memoryStream.ToArray());
        await this.JSRuntime.InvokeVoidAsync("topsyTurvy.downloadZip", "programme.zip", streamBase64);
    }

    /// <summary>
    /// Asks the user to confirm clearing the terminal output, and if confirmed, clears the terminal.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task ConfirmClearAsync()
    {
        bool? isClearConfirmed = await this.DialogService.ShowMessageBoxAsync(
            "Clear Terminal Output",
            "Are you sure you want to clear the terminal output?",
            yesText: "Clear",
            cancelText: "Cancel");

        if (isClearConfirmed == true)
        {
            await this.terminal!.Clear();
            this.lastRunOutput = string.Empty;
            await this.SavePreferencesAsync();
        }
    }

    /// <summary>
    /// Triggers a download of the terminal output as a text file, if there is any output to download.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task DownloadTerminalAsync()
    {
        if (!string.IsNullOrWhiteSpace(this.lastRunOutput))
        {
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.downloadText", "output.txt", this.lastRunOutput);
        }
    }

    /// <summary>
    /// Opens the new file dialog and if confirmed adds the file as a new tab.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task NewFileAsync()
    {
        IDialogReference dialog = await this.DialogService.ShowAsync<NewFileDialog>("Create New File");
        DialogResult? result = await dialog.Result;

        if (result is { Canceled: false, Data: string newName })
        {
            if (this.files.Any(file => file.Name == newName))
            {
                await this.DialogService.ShowMessageBoxAsync(
                    "File Already Exists",
                    $"A file named '{newName}' is already open.",
                    yesText: "OK");

                return;
            }

            this.files.Add(new(newName));
            await this.SwitchFileAsync(newName);
            this.StateHasChanged();
        }
    }

    /// <summary>
    /// Switches the active tab to the file with the given name saving the current file content first.
    /// </summary>
    /// <param name="name">The filename to switch to.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task SwitchFileAsync(string name)
    {
        await this.SyncActiveFileContentAsync();
        this.activeFileName = name;
        VirtualFile newFile = this.files.First(file => file.Name == name);
        await this.monacoEditor!.SetValue(newFile.Content);
        this.StateHasChanged();
    }

    /// <summary>
    /// Confirms with the user then closes the tab for the given file.
    /// </summary>
    /// <param name="name">The filename of the tab to close.</param>
    /// <remarks>
    /// If the file was the last tab open, a fresh file is created automatically.
    /// </remarks>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task CloseFileAsync(string name)
    {
        bool? isConfirmed = await this.DialogService.ShowMessageBoxAsync(
            "Close File",
            $"Close '{name}'?  Unsaved changes will be lost.",
            yesText: "Close",
            cancelText: "Cancel");

        if (isConfirmed != true)
        {
            return;
        }

        bool wasActive = this.activeFileName == name;
        int index = this.files.FindIndex(file => file.Name == name);
        this.files.RemoveAt(index);
        this.symbolTables.Remove(name);
        this.parsedSources.Remove(name);

        if (this.files.Count == 0)
        {
            VirtualFile replacement = new(DefaultFileName);
            this.files.Add(replacement);
            this.activeFileName = replacement.Name;
            await this.monacoEditor!.SetValue(string.Empty);
        }
        else if (wasActive)
        {
            int newIndex = Math.Min(index, this.files.Count - 1);
            this.activeFileName = this.files[newIndex].Name;
            await this.monacoEditor!.SetValue(this.files[newIndex].Content);
        }

        this.StateHasChanged();
    }

    /// <summary>
    /// Encodes all symbol occurrences from the given symbol table as a flat delta-encoded
    /// semantic token array compatible with the Monaco <c>DocumentSemanticTokensProvider</c>.
    /// </summary>
    /// <param name="symbolTable">The symbol table for the current source file.</param>
    /// <param name="lines">The source file split into lines.</param>
    /// <returns>A flat list of integers in the Monaco 5-int-per-token delta encoding.</returns>
    private IReadOnlyList<int> ComputeSemanticTokenData(SymbolTable symbolTable, string[] lines)
    {
        List<(int Line, int Char, int Length, int TokenType, int Modifiers)> tokens = [];

        foreach (SymbolInfo symbol in symbolTable.AllSymbols())
        {
            if (symbol.Name.Contains(' '))
            {
                continue;
            }

            int tokenType = symbol.Kind switch
            {
                SymbolKind.Function => 2,
                SymbolKind.Parameter => 1,
                _ => 0,
            };

            int modifiers = 0;
            if (symbol.IsConstant)
            {
                modifiers |= 1;
            }

            if (symbol.Documentation?.IsDeprecated == true)
            {
                modifiers |= 2;
            }

            foreach ((int line, int character) in SourceAnalyser.FindWordOccurrences(lines, symbol.Name))
            {
                tokens.Add((line, character, symbol.Name.Length, tokenType, modifiers));
            }
        }

        tokens.Sort((a, b) => a.Line != b.Line
            ? a.Line.CompareTo(b.Line)
            : a.Char.CompareTo(b.Char));

        List<int> data = new(tokens.Count * 5);
        int previousLine = 0;
        int previousCharacter = 0;

        foreach ((int line, int character, int length, int tokenType, int modifiers) in tokens)
        {
            int deltaLine = line - previousLine;
            data.Add(deltaLine);
            data.Add(deltaLine == 0
                ? character - previousCharacter
                : character);
            data.Add(length);
            data.Add(tokenType);
            data.Add(modifiers);
            previousLine = line;
            previousCharacter = character;
        }

        return data;
    }

    /// <summary>
    /// Parses a source and, if successful, stores the resulting
    /// <see cref="SymbolTable"/> and source text in the per-file dictionaries.
    /// </summary>
    /// <param name="fileName">The file name to key the results under.</param>
    /// <param name="source">The source text to parse.</param>
    private void BuildSymbolTableForFile(string fileName, string source)
    {
        TopsyTurvyParser parser = new();
        ParseResult result = parser.TryParse(source);
        if (result.Program is not null)
        {
            SymbolTable symbolTable = SymbolTable.Build(result.Program, source);
            ExternalFunctionRegistrar.Register(symbolTable);
            this.symbolTables[fileName] = symbolTable;
            this.parsedSources[fileName] = source;
        }
    }

    /// <summary>
    /// Reads the current editor content and stores it in the active <see cref="VirtualFile"/>.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task SyncActiveFileContentAsync()
    {
        VirtualFile? activeFile = this.files.Find(file => file.Name == this.activeFileName);
        if (activeFile is not null)
        {
            activeFile.Content = await this.JSRuntime.InvokeAsync<string>(
                "blazorMonaco.editor.getValue", "topsy-turvy-editor", false, null);
        }
    }

    /// <summary>
    /// Persists the current editor state to Local Storage.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task SavePreferencesAsync()
    {
        EditorPreferences preferences = new()
        {
            Files = [.. this.files],
            ActiveFile = this.activeFileName,
            CommandLineArguments = this.commandLineArgumentsText,
            StandardInput = this.stdinText,
            AreGsLabelsEnabled = this.areGsLabelsEnabled,
            IsDarkMode = this.IsDarkMode,
            TerminalOutput = this.lastRunOutput,
        };

        await this.JSRuntime.InvokeVoidAsync("topsyTurvy.savePreferences", preferences);
    }

    /// <summary>
    /// Handles the G&amp;S labels toggle, updating state and persisting the preference.
    /// </summary>
    /// <param name="value">The new toggle value.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task OnGsLabelsToggledAsync(bool value)
    {
        this.areGsLabelsEnabled = value;
        await this.SavePreferencesAsync();
    }
}
