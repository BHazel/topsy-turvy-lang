@using System
@using System.Collections.Generic
@using System.Linq
@using Blazor.Diagrams
@using Blazor.Diagrams.Components.Renderers
@using Blazor.Diagrams.Core.Anchors
@using Blazor.Diagrams.Core.Geometry;
@using Blazor.Diagrams.Core.Models;
@using Blazor.Diagrams.Core.Models.Base;
@using BWHazel.TopsyTurvy.Ast
@using BWHazel.TopsyTurvy.WebEditor.Visual

@namespace BWHazel.TopsyTurvy.WebEditor.Components.VisualEditor

@*
Represents a single node in the visual editor.

The node layout is a vertical stack of rows:

* Flow In: Zero-height for port circles to sit on the top edge of the node.
* Header: Coloured bar with the node title and optional subtitle and always the first visible element, flush to the node top.
* Data Ports: Input data on the left and output data on the right.
* Flow Out: Port circles with labels for branching nodes, such as conditional or try-catch, at the bottom.
*@
<div class="visual-node">

    @* Flow In Row *@
    @if (this.FlowInPorts.Any())
    {
        <div class="visual-node-flow-top">
            @foreach (TopsyTurvyVisualPortModel port in this.FlowInPorts)
            {
                <PortRenderer Port="@port" Class="visual-node-flow-port" />
            }
        </div>
    }

    @* Header *@
    <div class="visual-node-header visual-node-header-@(this.Node.Kind.ToString().ToLowerInvariant())">
        <div class="visual-node-title">@this.Node.Title</div>
        @if (this.Node.Subtitle is not null)
        {
            <div class="visual-node-subtitle">@this.Node.Subtitle</div>
        }
    </div>

    @* Data Ports *@
    @if (this.DataInPorts.Any() || this.DataOutPorts.Any())
    {
        <div class="visual-node-data-ports">
            <div class="visual-node-data-col visual-node-data-col--in">
                @foreach (TopsyTurvyVisualPortModel port in this.DataInPorts)
                {
                    <div class="visual-node-data-port-row">
                        <PortRenderer Port="@port" Class="visual-node-port-circle visual-node-port-circle--in" />
                        <span class="visual-node-port-label">@port.Label</span>
                    </div>
                }
            </div>
            <div class="visual-node-data-col visual-node-data-col--out">
                @foreach (TopsyTurvyVisualPortModel port in this.DataOutPorts)
                {
                    <div class="visual-node-data-port-row visual-node-data-port-row--out">
                        <span class="visual-node-port-label">@port.Label</span>
                        <PortRenderer Port="@port" Class="visual-node-port-circle visual-node-port-circle--out" />
                    </div>
                }
            </div>
        </div>
    }

    @* Editing Controls *@
    @if (!this.IsReadOnly && this.HasEditingControls)
    {
        <div class="visual-node-edit-section">
            @if (this.Node.Kind == VisualNodeKind.Program)
            {
                <MudTextField T="string" Label="Title" Value="@this.Node.SymbolIdentifierNodeName"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        this.Node.SymbolIdentifierNodeName = value;
                        this.Node.Subtitle = string.IsNullOrEmpty(this.Node.LiteralValue)
                            ? $"\"{value}\""
                            : $"\"{value}\" or, \"{this.Node.LiteralValue}\"";
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" Label="Subtitle (optional)" Value="@this.Node.LiteralValue"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        this.Node.LiteralValue = string.IsNullOrEmpty(value) ? null : value;
                        this.Node.Subtitle = string.IsNullOrEmpty(value)
                            ? $"\"{this.Node.SymbolIdentifierNodeName}\""
                            : $"\"{this.Node.SymbolIdentifierNodeName}\" or, \"{value}\"";
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense" />
            }
            else if (this.Node.Kind == VisualNodeKind.Declaration)
            {
                <MudTextField T="string" Label="Name" Value="@this.Node.SymbolIdentifierNodeName"
                    ValueChanged="@(v => this.OnPropertyChanged(() => this.Node.SymbolIdentifierNodeName = v))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudSelect T="LiteralType?" Label="Type" Value="@this.Node.NodeLiteralType"
                    ValueChanged="@(v => this.OnPropertyChanged(() => this.Node.NodeLiteralType = v))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (LiteralType literalType in Enum.GetValues<LiteralType>().Where(t => t != LiteralType.Null))
                    {
                        <MudSelectItem T="LiteralType?" Value="@((LiteralType?)literalType)">
                            @(VisualTypeMaps.TypeToKeyword.TryGetValue(literalType, out string? keyword) ? keyword : literalType.ToString())
                        </MudSelectItem>
                    }
                </MudSelect>
                @if (this.Node.NodeLiteralType == LiteralType.Array)
                {
                    <MudSelect T="LiteralType?" Label="Element Type" Value="@this.Node.ArrayElementLiteralType"
                        ValueChanged="@(v => this.OnPropertyChanged(() => this.Node.ArrayElementLiteralType = v))"
                        Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (LiteralType literalType in Enum.GetValues<LiteralType>().Where(type => type != LiteralType.Null && type != LiteralType.Array))
                        {
                            <MudSelectItem T="LiteralType?" Value="@((LiteralType?)literalType)">
                                @(VisualTypeMaps.TypeToKeyword.TryGetValue(literalType, out string? keyword) ? keyword : literalType.ToString())
                            </MudSelectItem>
                        }
                    </MudSelect>
                    @if (!this.HasArrayElementPorts)
                    {
                        <MudTextField T="string" Label="Size (optional)" Value="@this.Node.LiteralValue"
                            ValueChanged="@(value => this.OnPropertyChanged(() => this.Node.LiteralValue = string.IsNullOrWhiteSpace(value) ? null : value))"
                            Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    }
                    <MudButton StartIcon="@Icons.Material.Outlined.Add"
                        Size="MudBlazor.Size.Small"
                        OnClick="@this.AddArrayElementPort">Add Victim</MudButton>
                }
                <MudCheckBox T="bool" Label="Constant" Value="@this.Node.IsIdentifierConstant"
                    ValueChanged="@(v => this.OnPropertyChanged(() => this.Node.IsIdentifierConstant = v))"
                    Class="visual-node-edit-field" />
            }
            else if (this.Node.Kind == VisualNodeKind.Print)
            {
                <MudCheckBox T="bool" Label="Without Ceremony" Value="@this.Node.PrintSuppressNewline"
                    ValueChanged="@(value => this.OnPropertyChanged(() => this.Node.PrintSuppressNewline = value))"
                    Class="visual-node-edit-field" />
            }
            else if (this.Node.StatementType == "ImportNode")
            {
                <MudTextField T="string" Label="File" Value="@this.Node.SymbolIdentifierNodeName"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        this.Node.SymbolIdentifierNodeName = value;
                        this.Node.Subtitle = value;
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense" />
            }
            else if (this.Node.StatementType == "ArithmeticNode")
            {
                <MudSelect T="string" Label="Operator" Value="@this.Node.Title"
                    ValueChanged="@(value => this.OnPropertyChanged(() => this.Node.Title = value))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (string arithmeticOperator in ArithmeticOperators)
                    {
                        <MudSelectItem T="string" Value="@arithmeticOperator">@arithmeticOperator</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (this.Node.StatementType == "BitwiseNode")
            {
                <MudSelect T="string" Label="Operator" Value="@this.Node.Title"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        string previousTitle = this.Node.Title ?? string.Empty;
                        this.Node.Title = value;
                        this.AdjustOperatorPortCount(value, previousTitle);
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (string bitwiseOperator in BitwiseOperators)
                    {
                        <MudSelectItem T="string" Value="@bitwiseOperator">@bitwiseOperator</MudSelectItem>
                    }
                </MudSelect>
                @if (OptionallyBinaryOperators.Contains(this.Node.Title ?? string.Empty))
                {
                    @if (this.OperatorDataInPortCount == 1)
                    {
                        <MudButton StartIcon="@Icons.Material.Outlined.Add"
                            Size="MudBlazor.Size.Small"
                            OnClick="@this.AddOperatorArgumentPort">Add Argument</MudButton>
                    }
                    else
                    {
                        <MudButton StartIcon="@Icons.Material.Outlined.Remove"
                            Size="MudBlazor.Size.Small"
                            OnClick="@this.RemoveOperatorArgumentPort">Remove Argument</MudButton>
                    }
                }
            }
            else if (this.Node.StatementType == "LogicalNode")
            {
                <MudSelect T="string" Label="Operator" Value="@this.Node.Title"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        string previousTitle = this.Node.Title ?? string.Empty;
                        this.Node.Title = value;
                        this.AdjustOperatorPortCount(value, previousTitle);
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (string logicalOperator in LogicalOperators)
                    {
                        <MudSelectItem T="string" Value="@logicalOperator">@logicalOperator</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (this.Node.StatementType == "VariadicNode")
            {
                <MudSelect T="string" Label="Operator" Value="@this.Node.Title"
                    ValueChanged="@(value => this.OnPropertyChanged(() => this.Node.Title = value))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (string variadicOperator in VariadicOperators)
                    {
                        <MudSelectItem T="string" Value="@variadicOperator">@variadicOperator</MudSelectItem>
                    }
                </MudSelect>
                <MudButton StartIcon="@Icons.Material.Outlined.Add"
                    Size="MudBlazor.Size.Small"
                    OnClick="@this.AddOperatorArgumentPort">Add Argument</MudButton>
            }
            else if (this.Node.StatementType == "WovenNode")
            {
                <MudButton StartIcon="@Icons.Material.Outlined.Add"
                    Size="MudBlazor.Size.Small"
                    OnClick="@this.AddOperatorArgumentPort">Add Argument</MudButton>
            }
            else if (this.Node.StatementType == "ExpressionCastNode")
            {
                <MudSelect T="LiteralType?" Label="Cast To" Value="@this.Node.NodeLiteralType"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        this.Node.NodeLiteralType = value;
                        string typeLabel = value.HasValue && VisualTypeMaps.TypeToKeyword.TryGetValue(value.Value, out string? kw) ? kw : value?.ToString() ?? "?";
                        this.Node.Subtitle = $"→ {typeLabel}";
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (LiteralType literalType in Enum.GetValues<LiteralType>().Where(type => type != LiteralType.Null && type != LiteralType.Array))
                    {
                        <MudSelectItem T="LiteralType?" Value="@((LiteralType?)literalType)">
                            @(VisualTypeMaps.TypeToKeyword.TryGetValue(literalType, out string? keyword) ? keyword : literalType.ToString())
                        </MudSelectItem>
                    }
                </MudSelect>
            }
            else if (this.Node.StatementType == "FunctionBodyOpener")
            {
                <MudTextField T="string" Label="Name" Value="@this.Node.SymbolIdentifierNodeName"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        this.Node.SymbolIdentifierNodeName = value;
                        this.UpdateFunctionSubtitle();
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudCheckBox T="bool" Label="Void" Value="@(this.Node.NodeLiteralType is null)"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        this.Node.NodeLiteralType = value
                            ? null
                            : LiteralType.String;

                        this.UpdateFunctionSubtitle();
                    }))"
                    Class="visual-node-edit-field" />
                @if (this.Node.NodeLiteralType is not null)
                {
                    <MudSelect T="LiteralType?" Label="Return Type" Value="@this.Node.NodeLiteralType"
                        ValueChanged="@(value => this.OnPropertyChanged(() =>
                        {
                            this.Node.NodeLiteralType = value;
                            this.UpdateFunctionSubtitle();
                        }))"
                        Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (LiteralType literalType in Enum.GetValues<LiteralType>().Where(type => type != LiteralType.Null))
                        {
                            <MudSelectItem T="LiteralType?" Value="@((LiteralType?)literalType)">
                                @(VisualTypeMaps.TypeToKeyword.TryGetValue(literalType, out string? keyword) ? keyword : literalType.ToString())
                            </MudSelectItem>
                        }
                    </MudSelect>
                }
                <MudButton StartIcon="@Icons.Material.Outlined.Add"
                    Size="MudBlazor.Size.Small"
                    OnClick="@this.AddParameter">Add Parameter</MudButton>
            }
            else if (this.Node.StatementType == "ParameterNode")
            {
                <MudTextField T="string" Label="Name" Value="@this.Node.SymbolIdentifierNodeName"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        this.Node.SymbolIdentifierNodeName = value;
                        this.Node.Subtitle = value;
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudSelect T="LiteralType?" Label="Type" Value="@this.Node.NodeLiteralType"
                    ValueChanged="@(value => this.OnPropertyChanged(() => this.Node.NodeLiteralType = value))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (LiteralType literalType in Enum.GetValues<LiteralType>().Where(type => type != LiteralType.Null))
                    {
                        <MudSelectItem T="LiteralType?" Value="@((LiteralType?)literalType)">
                            @(VisualTypeMaps.TypeToKeyword.TryGetValue(literalType, out string? keyword) ? keyword : literalType.ToString())
                        </MudSelectItem>
                    }
                </MudSelect>
            }
            else if (this.Node.StatementType == "TryCatchOpener")
            {
                <MudTextField T="string" Label="Caught Variable" Value="@this.Node.SymbolIdentifierNodeName"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        this.Node.SymbolIdentifierNodeName = value;
                        this.Node.Subtitle = string.IsNullOrWhiteSpace(value)
                            ? "catch: error"
                            : $"catch: {value}";
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense" />
            }
            else if (this.Node.StatementType == "ConditionalOpener")
            {
                <MudButton StartIcon="@Icons.Material.Outlined.Add"
                    Size="MudBlazor.Size.Small"
                    OnClick="@this.AddElseIfBranch">Else If</MudButton>
            }
            else if (this.Node.StatementType == "SwitchOpener")
            {
                <MudButton StartIcon="@Icons.Material.Outlined.Add"
                    Size="MudBlazor.Size.Small"
                    OnClick="@this.AddSwitchCase">Case</MudButton>
                @if (this.SwitchCaseCount > 0)
                {
                    <MudButton StartIcon="@Icons.Material.Outlined.Remove"
                        Size="MudBlazor.Size.Small"
                        OnClick="@this.RemoveSwitchCase">Case</MudButton>
                }
            }
            else if (this.Node.StatementType == "SwitchCaseBranch")
            {
                <MudSelect T="LiteralType?" Label="Type" Value="@this.Node.NodeLiteralType"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        this.Node.NodeLiteralType = value;
                        this.Node.Subtitle = this.FormatLiteralSubtitle(value, this.Node.LiteralValue);
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (LiteralType literalType in SwitchCaseLiteralTypes)
                    {
                        <MudSelectItem T="LiteralType?" Value="@((LiteralType?)literalType)">
                            @(VisualTypeMaps.TypeToKeyword.TryGetValue(literalType, out string? keyword) ? keyword : literalType.ToString())
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" Label="Value" Value="@this.Node.LiteralValue"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        this.Node.LiteralValue = value;
                        this.Node.Subtitle = this.FormatLiteralSubtitle(this.Node.NodeLiteralType, value);
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense" />
            }
            else if (this.Node.StatementType == "LoopOpener")
            {
                <MudSelect T="string" Label="Loop Type" Value="@this.Node.Subtitle"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        this.Node.Subtitle = value;
                        this.UpdateLoopCondPort(value);
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (string loopType in LoopTypes)
                    {
                        <MudSelectItem T="string" Value="@loopType">@loopType</MudSelectItem>
                    }
                </MudSelect>
                @if (this.Node.Subtitle is "Ascending" or "Descending")
                {
                    <span class="visual-node-port-label" style="padding-left:4px;opacity:0.7">Connect Variable port to an Identifier</span>
                }
            }
            else if (this.Node.Kind == VisualNodeKind.Literal)
            {
                <MudSelect T="LiteralType?" Label="Type" Value="@this.Node.NodeLiteralType"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        this.Node.NodeLiteralType = value;
                        this.Node.Subtitle = this.FormatLiteralSubtitle(value, this.Node.LiteralValue);
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (LiteralType literalType in Enum.GetValues<LiteralType>().Where(type => type != LiteralType.Null))
                    {
                        <MudSelectItem T="LiteralType?" Value="@((LiteralType?)literalType)">
                            @(VisualTypeMaps.TypeToKeyword.TryGetValue(literalType, out string? keyword) ? keyword : literalType.ToString())
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" Label="Value" Value="@this.Node.LiteralValue"
                    ValueChanged="@(value => this.OnPropertyChanged(() =>
                    {
                        this.Node.LiteralValue = value;
                        this.Node.Subtitle = this.FormatLiteralSubtitle(this.Node.NodeLiteralType, value);
                    }))"
                    Class="visual-node-edit-field" Variant="Variant.Outlined" Margin="Margin.Dense" />
            }
        </div>
    }

    @* Flow Out / Branch Out *@
    @if (this.BottomFlowPorts.Any())
    {
        <div class="visual-node-flow-bottom">
            @foreach (TopsyTurvyVisualPortModel port in this.BottomFlowPorts)
            {
                <div class="visual-node-flow-bottom-item">
                    @if (this.BottomFlowPorts.Count() > 1)
                    {
                        <span class="visual-node-port-label">@port.Label</span>
                    }

                    <PortRenderer Port="@port" Class="visual-node-flow-port" />
                </div>
            }

        </div>
    }

</div>

@code {
    /// <summary>
    /// Gets or sets the node model to render.
    /// </summary>
    /// <remarks>
    /// Injected by Z.Blazor.Diagrams.
    /// </remarks>
    [Parameter]
    public TopsyTurvyVisualNodeModel Node { get; set; } = default!;

    /// <summary>
    /// Gets or sets a value indicating whether the visual editor is in read-only mode.
    /// </summary>
    [CascadingParameter(Name = "IsReadOnly")]
    public bool IsReadOnly { get; set; } = true;

    /// <summary>
    /// Gets or sets the callback to invoke when a node property is changed via an editing control.
    /// </summary>
    [CascadingParameter(Name = "OnNodeChanged")]
    public EventCallback OnNodeChanged { get; set; }

    /// <summary>
    /// Gets or sets the diagram instance.
    /// </summary>
    [CascadingParameter]
    public BlazorDiagram Diagram { get; set; } = default!;

    /// <summary>
    /// Gets a value indicating whether this node kind has any editing controls.
    /// </summary>
    private bool HasEditingControls =>
        (this.Node.Kind == VisualNodeKind.Program && this.Node.Title != "FINALE.") ||
        this.Node.Kind is VisualNodeKind.Declaration or VisualNodeKind.Print or VisualNodeKind.Literal or VisualNodeKind.Operator ||
        this.Node.StatementType == "ImportNode" ||
        this.Node.StatementType == "ConditionalOpener" ||
        this.Node.StatementType == "SwitchOpener" ||
        this.Node.StatementType == "SwitchCaseBranch" ||
        this.Node.StatementType == "LoopOpener" ||
        this.Node.StatementType == "FunctionBodyOpener" ||
        this.Node.StatementType == "ParameterNode" ||
        this.Node.StatementType == "TryCatchOpener";

    private static readonly IReadOnlyList<string> LoopTypes = ["Infinite", "Ascending", "Descending", "Whilst"];

    /// <summary>
    /// The literal types a <c>WHEN ACTING AS</c> case value can be, matching the alternatives
    /// <c>StatementParser.SwitchBody</c> accepts for a case literal.
    /// </summary>
    private static readonly IReadOnlyList<LiteralType> SwitchCaseLiteralTypes =
        [LiteralType.Integer, LiteralType.Long, LiteralType.Double, LiteralType.String, LiteralType.Boolean];

    private static readonly IReadOnlyList<string> ArithmeticOperators =
    [
        "SUM OF", "DIFFERENCE OF", "PRODUCT OF", "QUOTIENT OF", "REMAINDER OF",
        "LARGER OF", "SMALLER OF", "PRE-ADAMITE", "LOWER DEGREE",
    ];

    private static readonly IReadOnlyList<string> BitwiseOperators =
    [
        "CHORD OF", "HARMONY OF", "DISCORD OF",
        "INVERSION OF", "TRANSPOSITION UP", "TRANSPOSITION DOWN",
    ];

    private static readonly IReadOnlyList<string> LogicalOperators = ["BOTH", "EITHER", "HARDLY EVER", "ALIKE", "UNLIKE"];

    private static readonly IReadOnlyList<string> VariadicOperators = ["ALL OF", "ANY OF"];

    private static readonly IReadOnlySet<string> UnaryOperators =
        new HashSet<string> { "HARDLY EVER", "INVERSION OF" };

    private static readonly IReadOnlySet<string> OptionallyBinaryOperators =
        new HashSet<string> { "TRANSPOSITION UP", "TRANSPOSITION DOWN" };

    /// <summary>
    /// Gets the number of Data In ports on the current node.
    /// </summary>
    /// <returns>The number of Data In ports.</returns>
    private int OperatorDataInPortCount => this.Node.Ports
        .OfType<TopsyTurvyVisualPortModel>()
        .Count(port => port.Role == VisualPortRole.DataIn);

    /// <summary>
    /// Adjusts the number of Data In ports for a bitwise or logical operator node based on the selected operator.
    /// </summary>
    /// <param name="operatorNodeTitle">The newly selected operator title.</param>
    /// <param name="previousOperatorTitle">The operator title before the change.</param>
    private void AdjustOperatorPortCount(string operatorNodeTitle, string previousOperatorTitle)
    {
        bool targetIsUnary = UnaryOperators.Contains(operatorNodeTitle);
        bool targetIsOptionallyBinary = OptionallyBinaryOperators.Contains(operatorNodeTitle);

        if (targetIsOptionallyBinary && OptionallyBinaryOperators.Contains(previousOperatorTitle))
        {
            return;
        }

        if (targetIsUnary || targetIsOptionallyBinary)
        {
            this.RemoveLastDataInPort();
            return;
        }

        if (this.OperatorDataInPortCount < 2)
        {
            this.Node.AddPort(new TopsyTurvyVisualPortModel(
                this.Node, Blazor.Diagrams.Core.Models.PortAlignment.Left, "Arg 2", VisualPortRole.DataIn));
        }
    }

    /// <summary>
    /// Removes the most-recently-added Data In port, along with any link attached to it.
    /// </summary>
    /// <remarks>
    /// Ports are always added in argument order so the last Data In port in <see cref="NodeModel.Ports"/> is
    /// always the highest-numbered argument, regardless of its label text.
    /// </remarks>
    private void RemoveLastDataInPort()
    {
        TopsyTurvyVisualPortModel? port = this.Node.Ports
            .OfType<TopsyTurvyVisualPortModel>()
            .LastOrDefault(port => port.Role == VisualPortRole.DataIn);

        if (port is null)
        {
            return;
        }

        foreach (BaseLinkModel link in port.Links.ToList())
        {
            this.Diagram.Links.Remove(link);
        }

        this.Node.RemovePort(port);
    }

    /// <summary>
    /// Adds a new Data In port for an additional argument to a variadic or WOVEN OF operator node.
    /// </summary>
    private async Task AddOperatorArgumentPort()
    {
        int argIndex = this.Node.Ports
            .OfType<TopsyTurvyVisualPortModel>()
            .Count(port => port.Role == VisualPortRole.DataIn);

        TopsyTurvyVisualPortModel? port = new(this.Node, PortAlignment.Left, $"Arg {argIndex + 1}", VisualPortRole.DataIn);
        this.Node.AddPort(port);
        this.Node.Refresh();
        await this.OnNodeChanged.InvokeAsync();
    }

    /// <summary>
    /// Removes the most-recently-added argument port from an optionally-binary operator node.
    /// </summary>
    private async Task RemoveOperatorArgumentPort()
    {
        this.RemoveLastDataInPort();
        this.Node.Refresh();
        await this.OnNodeChanged.InvokeAsync();
    }

    /// <summary>
    /// Adds a new Data In port for an additional argument to a SUMMON node.
    /// </summary>
    private async Task AddSummonArgumentPort()
    {
        int argumentIndex = this.Node.Ports
            .OfType<TopsyTurvyVisualPortModel>()
            .Count(port => port.Role == VisualPortRole.DataIn && port.Label != "Function");

        TopsyTurvyVisualPortModel? port = new TopsyTurvyVisualPortModel(this.Node, PortAlignment.Left, $"Arg {argumentIndex + 1}", VisualPortRole.DataIn);
        this.Node.AddPort(port);
        this.Node.Refresh();
        await this.OnNodeChanged.InvokeAsync();
    }

    /// <summary>
    /// Adds a new Else If branch to a <c>ConditionalOpener</c> node.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task AddElseIfBranch()
    {
        int elseIfIndex = this.Node.Ports
            .OfType<TopsyTurvyVisualPortModel>()
            .Count(port => port.Role == VisualPortRole.BranchOut && port.Label?.StartsWith("Else If") == true);

        TopsyTurvyVisualPortModel branchPort = new(this.Node, PortAlignment.Bottom, $"Else If {elseIfIndex + 1}", VisualPortRole.BranchOut);
        this.Node.AddPort(branchPort);

        // Create the OR, IF NOT, header node below and to the right of the opener.
        const double spacing = 660.0;
        double headerX = this.Node.Position.X + (elseIfIndex + 1) * spacing;
        double headerY = this.Node.Position.Y + NodeLayoutContext.RowSpacing;
        string headerId = $"factory-elseif-{Guid.NewGuid():N}";

        TopsyTurvyVisualNodeModel headerNode = new(headerId, new Point(headerX, headerY), "OR, IF NOT,", null, VisualNodeKind.Conditional)
        {
            StatementType = "ConditionalElseIfBranch",
        };

        TopsyTurvyVisualPortModel headerInPort = new(headerNode, PortAlignment.Top, "In", VisualPortRole.FlowIn);
        headerNode.AddPort(headerInPort);

        TopsyTurvyVisualPortModel headerCondPort = new(headerNode, PortAlignment.Left, "Cond", VisualPortRole.DataIn);
        headerNode.AddPort(headerCondPort);

        TopsyTurvyVisualPortModel headerOutPort = new(headerNode, PortAlignment.Bottom, "Out", VisualPortRole.FlowOut);
        headerNode.AddPort(headerOutPort);

        this.Diagram.Nodes.Add(headerNode);
        this.Diagram.Links.Add(new LinkModel(branchPort, headerInPort));

        TopsyTurvyVisualNodeModel? closerNode = this.Diagram.Nodes
            .OfType<TopsyTurvyVisualNodeModel>()
            .FirstOrDefault(visualNode => visualNode.Id == this.Node.PairedCloserId);

        if (closerNode is not null)
        {
            PortModel? closerInPort = closerNode.Ports.OfType<TopsyTurvyVisualPortModel>().FirstOrDefault(port => port.Role == VisualPortRole.FlowIn);
            if (closerInPort is not null)
            {
                this.Diagram.Links.Add(new LinkModel(headerOutPort, closerInPort));
            }
        }

        this.Node.Refresh();
        await this.OnNodeChanged.InvokeAsync();
    }

    /// <summary>
    /// Gets the number of case branches on a <c>SwitchOpener</c> node.
    /// </summary>
    /// <remarks>
    /// Counts every Branch Out port other than "Default", not just ones already named "Case N": a case
    /// loaded from source is labelled with its own literal text, e.g. "1", not "Case 1", so counting
    /// only the "Case " prefix would under-count.
    /// </remarks>
    private int SwitchCaseCount =>
        this.Node.Ports.OfType<TopsyTurvyVisualPortModel>().Count(port => port.Role == VisualPortRole.BranchOut && port.Label != "Default");

    /// <summary>
    /// Adds a new case branch to a <c>SwitchOpener</c> node.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task AddSwitchCase()
    {
        int caseIndex = this.SwitchCaseCount;

        TopsyTurvyVisualPortModel branchPort = new(this.Node, PortAlignment.Bottom, $"Case {caseIndex + 1}", VisualPortRole.BranchOut);
        this.Node.AddPort(branchPort);

        // Create the WHEN ACTING AS header node below and to the right of the opener.
        const double spacing = 440.0;
        double headerX = this.Node.Position.X + (caseIndex + 1) * spacing;
        double headerY = this.Node.Position.Y + NodeLayoutContext.RowSpacing;
        string headerId = $"factory-switchcase-{Guid.NewGuid():N}";

        TopsyTurvyVisualNodeModel headerNode = new(headerId, new Point(headerX, headerY), "WHEN ACTING AS", $"case {caseIndex + 1}", VisualNodeKind.Conditional)
        {
            StatementType = "SwitchCaseBranch",
            NodeLiteralType = LiteralType.Integer,
            LiteralValue = (caseIndex + 1).ToString(),
        };

        TopsyTurvyVisualPortModel headerInPort = new(headerNode, PortAlignment.Top, "In", VisualPortRole.FlowIn);
        headerNode.AddPort(headerInPort);

        TopsyTurvyVisualPortModel headerOutPort = new(headerNode, PortAlignment.Bottom, "Out", VisualPortRole.FlowOut);
        headerNode.AddPort(headerOutPort);

        this.Diagram.Nodes.Add(headerNode);
        this.Diagram.Links.Add(new LinkModel(branchPort, headerInPort));

        TopsyTurvyVisualNodeModel? closerNode = this.Diagram.Nodes
            .OfType<TopsyTurvyVisualNodeModel>()
            .FirstOrDefault(visualNode => visualNode.Id == this.Node.PairedCloserId);

        if (closerNode is not null)
        {
            PortModel? closerInPort = closerNode.Ports.OfType<TopsyTurvyVisualPortModel>().FirstOrDefault(port => port.Role == VisualPortRole.FlowIn);
            if (closerInPort is not null)
            {
                this.Diagram.Links.Add(new LinkModel(headerOutPort, closerInPort));
            }
        }

        this.Node.Refresh();
        await this.OnNodeChanged.InvokeAsync();
    }

    /// <summary>
    /// Removes the most-recently-added case branch from a <c>SwitchOpener</c> node, along with its header
    /// and everything wired into its body.
    /// </summary>
    /// <remarks>
    /// Cases are always appended in declaration order so the last case Branch Out port in
    /// <see cref="NodeModel.Ports"/> is always the most recently added case, mirroring
    /// the <see cref="RemoveLastDataInPort"/> convention of trusting port order over label text.
    /// </remarks>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task RemoveSwitchCase()
    {
        TopsyTurvyVisualPortModel? casePort = this.Node.Ports
            .OfType<TopsyTurvyVisualPortModel>()
            .LastOrDefault(port => port.Role == VisualPortRole.BranchOut && port.Label != "Default");

        if (casePort is null)
        {
            return;
        }

        HashSet<string> nodesToRemove = [];
        foreach (BaseLinkModel link in casePort.Links.ToList())
        {
            if ((link.Target as SinglePortAnchor)?.Port?.Parent is TopsyTurvyVisualNodeModel header)
            {
                nodesToRemove.Add(header.Id);
                CollectCaseBody(header, nodesToRemove, this.Node.PairedCloserId);
            }

            this.Diagram.Links.Remove(link);
        }

        this.Node.RemovePort(casePort);

        foreach (TopsyTurvyVisualNodeModel node in this.Diagram.Nodes
            .OfType<TopsyTurvyVisualNodeModel>()
            .Where(node => nodesToRemove.Contains(node.Id))
            .ToList())
        {
            this.Diagram.Nodes.Remove(node);
        }

        this.Node.Refresh();
        await this.OnNodeChanged.InvokeAsync();
    }

    /// <summary>
    /// Walks the Flow Out chain starting from the given node, adding all reachable nodes to the given set
    /// of IDs, stopping at <paramref name="stopAtId"/>, the switch closer, if reached.
    /// </summary>
    /// <param name="node">The starting node.</param>
    /// <param name="ids">The set of node IDs to add to.</param>
    /// <param name="stopAtId">The ID of the node at which to stop walking, or <c>null</c> to walk until the end of the flow.</param>
    private static void CollectCaseBody(TopsyTurvyVisualNodeModel node, HashSet<string> ids, string? stopAtId)
    {
        TopsyTurvyVisualPortModel? flowOut = node.Ports
            .OfType<TopsyTurvyVisualPortModel>()
            .FirstOrDefault(port => port.Role == VisualPortRole.FlowOut);

        if (flowOut is null)
        {
            return;
        }

        foreach (BaseLinkModel link in flowOut.Links)
        {
            NodeModel? next = (link.Target as SinglePortAnchor)?.Port?.Parent;
            if (next is null || next.Id == stopAtId || ids.Contains(next.Id))
            {
                continue;
            }

            ids.Add(next.Id);
            if (next is TopsyTurvyVisualNodeModel nextTyped)
            {
                CollectCaseBody(nextTyped, ids, stopAtId);
            }
        }
    }

    /// <summary>
    /// Adds or removes the <c>Cond</c> Data In port on a loop opener node based on the selected loop type.
    /// </summary>
    /// <param name="loopType">The selected loop type subtitle string.</param>
    /// <remarks>
    /// Infinite loops have no condition expression, so the Cond port is hidden when "Infinite" is selected
    /// and shown for all other loop types.
    /// </remarks>
    private void UpdateLoopCondPort(string loopType)
    {
        bool needsConditionPort = loopType != "Infinite";
        bool hasConditionPort = this.Node.Ports
            .OfType<TopsyTurvyVisualPortModel>()
            .Any(port => port.Role == VisualPortRole.DataIn && port.Label == "Cond");

        if (needsConditionPort && !hasConditionPort)
        {
            this.Node.AddPort(new TopsyTurvyVisualPortModel(this.Node, PortAlignment.Left, "Cond", VisualPortRole.DataIn));
        }

        bool needsLoopVariable = loopType is "Ascending" or "Descending";
        bool hasLoopVariable = this.Node.Ports
            .OfType<TopsyTurvyVisualPortModel>()
            .Any(port => port.Role == VisualPortRole.DataIn && port.Label == "Variable");

        if (needsLoopVariable && !hasLoopVariable)
        {
            this.Node.AddPort(new TopsyTurvyVisualPortModel(this.Node, PortAlignment.Left, "Variable", VisualPortRole.DataIn));
        }

        this.Node.Refresh();
    }

    /// <summary>
    /// Updates the subtitle of a <c>FunctionBodyOpener</c> node to reflect the current name and return type.
    /// </summary>
    private void UpdateFunctionSubtitle()
    {
        string functionName = this.Node.SymbolIdentifierNodeName ?? "functionName";
        string returnPart = this.Node.NodeLiteralType.HasValue && VisualTypeMaps.TypeToKeyword.TryGetValue(this.Node.NodeLiteralType.Value, out string? keyword)
            ? $" → {keyword}"
            : string.Empty;
        
        this.Node.Subtitle = $"{functionName}{returnPart}";
    }

    /// <summary>
    /// Adds a new <c>TERM</c> parameter node to the diagram and connects it to a new <c>Param N</c> Data In port
    /// on the function body opener.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task AddParameter()
    {
        int paramIndex = this.Node.Ports
            .OfType<TopsyTurvyVisualPortModel>()
            .Count(port => port.Role == VisualPortRole.DataIn && port.Label?.StartsWith("Param ") == true);

        TopsyTurvyVisualPortModel paramPort = new(this.Node, PortAlignment.Left, $"Param {paramIndex + 1}", VisualPortRole.DataIn);
        this.Node.AddPort(paramPort);

        string termId = $"factory-param-{Guid.NewGuid():N}";
        double termX = this.Node.Position.X - 280;
        double termY = this.Node.Position.Y + paramIndex * NodeLayoutContext.RowSpacing;

        TopsyTurvyVisualNodeModel termVisualNode = new(termId, new Point(termX, termY), "TERM", null, VisualNodeKind.Parameter)
        {
            StatementType = "ParameterNode",
        };

        TopsyTurvyVisualPortModel termOutPort = new(termVisualNode, PortAlignment.Right, "Out", VisualPortRole.DataOut);
        termVisualNode.AddPort(termOutPort);

        this.Diagram.Nodes.Add(termVisualNode);
        this.Diagram.Links.Add(new LinkModel(termOutPort, paramPort));

        this.Node.Refresh();
        await this.OnNodeChanged.InvokeAsync();
    }

    /// <summary>
    /// Gets a value indicating whether this array declaration node has any Data In ports for array element values.
    /// </summary>
    private bool HasArrayElementPorts => this.Node.Ports
        .OfType<TopsyTurvyVisualPortModel>()
        .Any(port => port.Role == VisualPortRole.DataIn && port.Label?.StartsWith("Victim ") == true);

    /// <summary>
    /// Gets the Flow In ports for this node, which render at the top of the node.
    /// </summary>
    private IEnumerable<TopsyTurvyVisualPortModel> FlowInPorts => this.Node.Ports.OfType<TopsyTurvyVisualPortModel>().Where(port => port.Role == VisualPortRole.FlowIn);

    /// <summary>
    /// Gets the Data In ports for this node, which render on the left side of the node.
    /// </summary>
    private IEnumerable<TopsyTurvyVisualPortModel> DataInPorts => this.Node.Ports.OfType<TopsyTurvyVisualPortModel>().Where(port => port.Role == VisualPortRole.DataIn);

    /// <summary>
    /// Gets the Data Out ports for this node, which render on the right side of the node.
    /// </summary>
    private IEnumerable<TopsyTurvyVisualPortModel> DataOutPorts=> this.Node.Ports.OfType<TopsyTurvyVisualPortModel>().Where(port => port.Role == VisualPortRole.DataOut);

    /// <summary>
    /// Gets the Flow Out and Branch Out ports for this node, which render at the bottom of the node.
    /// </summary>
    private IEnumerable<TopsyTurvyVisualPortModel> BottomFlowPorts => this.Node.Ports.OfType<TopsyTurvyVisualPortModel>()
        .Where(port => port.Role == VisualPortRole.FlowOut || port.Role == VisualPortRole.BranchOut);

    /// <summary>
    /// Applies a property mutation to the node model and fires <see cref="OnNodeChanged"/> to trigger source regeneration.
    /// </summary>
    /// <param name="updateModel">The action that updates the model property.</param>
    private async Task OnPropertyChanged(Action updateModel)
    {
        updateModel();
        this.Node.Refresh();
        await this.OnNodeChanged.InvokeAsync();
    }

    /// <summary>
    /// Formats the subtitle for a Literal node.
    /// </summary>
    /// <param name="type">The literal type.</param>
    /// <param name="value">The literal value.</param>
    /// <returns>A formatted subtitle string.</returns>
    private string FormatLiteralSubtitle(LiteralType? type, string? value)
    {
        string typeDisplay = type.HasValue && VisualTypeMaps.TypeToKeyword.TryGetValue(type.Value, out string? keyword)
            ? keyword
            : type?.ToString() ?? "?";
        return $"{typeDisplay} : {value ?? Keywords.Literals.Naught}";
    }

    /// <summary>
    /// Adds a new Data In port for an array element value to a Declaration node of array type.
    /// </summary>
    private async Task AddArrayElementPort()
    {
        int victimIndex = this.Node.Ports
            .OfType<TopsyTurvyVisualPortModel>()
            .Count(port => port.Role == VisualPortRole.DataIn && port.Label?.StartsWith("Victim ") == true);
        
        var port = new TopsyTurvyVisualPortModel(this.Node, PortAlignment.Left, $"Victim {victimIndex + 1}", VisualPortRole.DataIn);
        this.Node.AddPort(port);
        this.Node.Refresh();
        await this.OnNodeChanged.InvokeAsync();
    }
}
