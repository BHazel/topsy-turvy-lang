// SYNTAX TEST "source.utopir"

// ── Declaration, assignment, cast ────────────────────────────────

£x = welcome peer
//   ^ keyword.other.declaration.utopir

£x = appoint 42
//   ^ keyword.operator.assignment.utopir

£y = were £x, chancellor
//   ^ keyword.operator.cast.utopir

// ── Integer arithmetic ───────────────────────────────────────────

£r = sum £a, £b
//   ^ keyword.operator.arithmetic.utopir

£r = diff £a, £b
//   ^ keyword.operator.arithmetic.utopir

£r = prod £a, £b
//   ^ keyword.operator.arithmetic.utopir

£r = quot £a, £b
//   ^ keyword.operator.arithmetic.utopir

£r = rem £a, £b
//   ^ keyword.operator.arithmetic.utopir

£r = max £a, £b
//   ^ keyword.operator.arithmetic.utopir

£r = min £a, £b
//   ^ keyword.operator.arithmetic.utopir

// ── Floating-point arithmetic: the caret lands on the ".f" suffix itself, not the mnemonic prefix, so this fails if the plain integer group is ever accidentally reordered before this one ─

£r = sum.f £a, £b
//       ^ keyword.operator.arithmetic.float.utopir

£r = diff.f £a, £b
//     ^ keyword.operator.arithmetic.float.utopir

£r = prod.f £a, £b
//        ^ keyword.operator.arithmetic.float.utopir

£r = quot.f £a, £b
//        ^ keyword.operator.arithmetic.float.utopir

£r = rem.f £a, £b
//       ^ keyword.operator.arithmetic.float.utopir

£r = max.f £a, £b
//       ^ keyword.operator.arithmetic.float.utopir

£r = min.f £a, £b
//       ^ keyword.operator.arithmetic.float.utopir

// ── Bitwise ──────────────────────────────────────────────────────

£r = chord £a, £b
//   ^ keyword.operator.bitwise.utopir

£r = harmony £a, £b
//   ^ keyword.operator.bitwise.utopir

£r = discord £a, £b
//   ^ keyword.operator.bitwise.utopir

£r = inv £a
//   ^ keyword.operator.bitwise.utopir

£r = transup £a, 1
//   ^ keyword.operator.bitwise.utopir

£r = transdown £a, 1
//   ^ keyword.operator.bitwise.utopir

// ── Integer comparison ───────────────────────────────────────────

£r = alike £a, £b
//   ^ keyword.operator.comparison.utopir

£r = unlike £a, £b
//   ^ keyword.operator.comparison.utopir

£r = preadam £a, £b
//   ^ keyword.operator.comparison.utopir

£r = lowerdeg £a, £b
//   ^ keyword.operator.comparison.utopir

// ── Floating-point comparison: the caret lands on the ".f" suffix itself, not the mnemonic prefix, so this fails if the plain integer group is ever accidentally reordered before this one ─

£r = alike.f £a, £b
//         ^ keyword.operator.comparison.float.utopir

£r = unlike.f £a, £b
//          ^ keyword.operator.comparison.float.utopir

£r = preadam.f £a, £b
//           ^ keyword.operator.comparison.float.utopir

£r = lowerdeg.f £a, £b
//            ^ keyword.operator.comparison.float.utopir

// ── Logical ──────────────────────────────────────────────────────

£r = both £a, £b
//   ^ keyword.operator.logical.utopir

£r = either £a, £b
//   ^ keyword.operator.logical.utopir

£r = hardly £a
//   ^ keyword.operator.logical.utopir

// ── Stack ────────────────────────────────────────────────────────

prentice 42
//^ keyword.other.stack.utopir

£r = leave
//   ^ keyword.other.stack.utopir

// ── Function call: the caret for "summon.find" lands on the ".find" suffix itself, so this fails if the plain "summon" group is ever accidentally reordered before this one ─

summon &DoNothing
//^ keyword.control.utopir

£r = summon.find &Sample
//          ^ keyword.control.utopir

// ── Control flow, valued and void ────────────────────────────────

find £r
//^ keyword.control.utopir

find
//^ keyword.control.utopir

sailalike £a, !LOGIC
//^ keyword.control.utopir

sailunlike £a, !LOGIC
//^ keyword.control.utopir

sail !LOGIC
//^ keyword.control.utopir

// ── Victim (string/array access) ─────────────────────────────────

£r = victim.yarn £y, 4
//   ^ keyword.other.access.utopir

£r = victim.list £a, 2
//   ^ keyword.other.access.utopir

// ── Arrays: the caret lands on the ".list"/".victim" suffix itself, so this fails if the plain declaration/assignment groups are ever accidentally reordered before this one ─

£a = welcome.list peer, 3
//           ^ keyword.other.declaration.utopir

appoint.victim £a, 1, 10
//      ^ keyword.operator.assignment.utopir

// ── Pointers ─────────────────────────────────────────────────────

£p = welcome.gallerypic peer
//           ^ keyword.other.declaration.utopir

£p = pictureto £n
//   ^ keyword.other.access.utopir

£n = viewfrom £p
//   ^ keyword.other.access.utopir

viewto £p, 23
//^ keyword.other.access.utopir

// ── Pointer arithmetic: the caret lands on the ".g" suffix itself, so this fails if the plain arithmetic group is ever accidentally reordered before this one ─

£r = sum.g £p, 1
//       ^ keyword.operator.arithmetic.pointer.utopir

£r = diff.g £p, 1
//        ^ keyword.operator.arithmetic.pointer.utopir
