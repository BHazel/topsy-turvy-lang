{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Topsy Turvy",
  "scopeName": "source.topsy",
  "fileTypes": ["topsy"],
  "patterns": [
    { "include": "#block-comments" },
    { "include": "#line-comments" },
    { "include": "#strings" },
    { "include": "#char-literals" },
    { "include": "#numbers" },
    { "include": "#boolean-literals" },
    { "include": "#null-literal" },
    { "include": "#implicit-variable" },
    { "include": "#program-structure" },
    { "include": "#sections" },
    { "include": "#control-flow" },
    { "include": "#switch" },
    { "include": "#loops" },
    { "include": "#exceptions" },
    { "include": "#functions" },
    { "include": "#io" },
    { "include": "#import" },
    { "include": "#namespace" },
    { "include": "#cast" },
    { "include": "#declaration" },
    { "include": "#assignment" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "block-comments": {
      "name": "comment.block.topsy",
      "begin": "(?i)\\(ASIDE,\\s+AT\\s+SOME\\s+LENGTH:",
      "beginCaptures": {
        "0": { "name": "comment.block.topsy" }
      },
      "end": "(?i)END\\s+OF\\s+ASIDE\\.\\)",
      "endCaptures": {
        "0": { "name": "comment.block.topsy" }
      }
    },
    "line-comments": {
      "name": "comment.line.topsy",
      "match": "(?i)ASIDE:.*$"
    },
    "char-literals": {
      "name": "string.quoted.single.topsy",
      "match": "'(~[nt'~]|[^'])'"
    },
    "strings": {
      "name": "string.quoted.double.topsy",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.topsy",
          "match": "~[nt\"~]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.topsy",
          "match": "(?i)\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.topsy",
          "match": "(?i)\\b[0-9]+\\b"
        }
      ]
    },
    "boolean-literals": {
      "name": "constant.language.boolean.topsy",
      "match": "(?i)\\b(VERITY|NAY)\\b"
    },
    "null-literal": {
      "name": "constant.language.null.topsy",
      "match": "(?i)\\bNAUGHT\\b"
    },
    "implicit-variable": {
      "name": "variable.language.topsy",
      "match": "(?i)(?:\\bJUST\\s+SO\\b|\\bTHE\\s+PROPS\\b)"
    },
    "program-structure": {
      "patterns": [
        {
          "name": "keyword.control.program.topsy",
          "match": "(?i)\\bHARK!"
        },
        {
          "name": "keyword.control.program.topsy",
          "match": "(?i)\\bFINALE\\."
        },
        {
          "name": "keyword.control.program.topsy",
          "match": "(?i)\\bor,(?!\\s+IF\\s+NOT,)"
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "keyword.control.section.topsy",
          "match": "(?i)\\bPRINCIPALS\\b"
        },
        {
          "name": "keyword.control.section.topsy",
          "match": "(?i)\\bTHE\\s+CURTAIN\\s+RISES\\."
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.topsy",
          "match": "(?i)\\bSHOULD\\s+IT\\s+TRANSPIRE\\s+THAT\\b"
        },
        {
          "name": "keyword.control.topsy",
          "match": "(?i)\\bQUITE\\s+SO\\."
        },
        {
          "name": "keyword.control.topsy",
          "match": "(?i)\\bOR,\\s+IF\\s+NOT,"
        },
        {
          "name": "keyword.control.topsy",
          "match": "(?i)\\bOTHERWISE,"
        },
        {
          "name": "keyword.control.topsy",
          "match": "(?i)\\bSO\\s+MUCH\\s+FOR\\s+THAT\\."
        },
        {
          "name": "keyword.control.topsy",
          "match": "(?i)\\bYEOMAN\\b"
        },
        {
          "name": "keyword.control.topsy",
          "match": "(?i)\\bUNDER\\s+ORDERS\\."
        }
      ]
    },
    "switch": {
      "patterns": [
        {
          "name": "keyword.control.switch.topsy",
          "match": "(?i)\\bIN\\s+WHICH\\s+CAPACITY\\?"
        },
        {
          "name": "keyword.control.switch.topsy",
          "match": "(?i)\\bWHEN\\s+ACTING\\s+AS\\b"
        },
        {
          "name": "keyword.control.switch.topsy",
          "match": "(?i)\\bFAILING\\s+ALL\\s+OF\\s+THE\\s+ABOVE,"
        },
        {
          "name": "keyword.control.switch.topsy",
          "match": "(?i)\\bNOTHING\\s+COULD\\s+BE\\s+MORE\\s+SATISFACTORY\\."
        }
      ]
    },
    "loops": {
      "patterns": [
        {
          "name": "keyword.control.loop.topsy",
          "match": "(?i)\\bBY\\s+A\\s+LEGAL\\s+FICTION\\b"
        },
        {
          "name": "keyword.control.loop.topsy",
          "match": "(?i)\\bKNOWN\\s+AS\\b"
        },
        {
          "name": "keyword.control.loop.topsy",
          "match": "(?i)\\bASCENDING\\b"
        },
        {
          "name": "keyword.control.loop.topsy",
          "match": "(?i)\\bDESCENDING\\b"
        },
        {
          "name": "keyword.control.loop.topsy",
          "match": "(?i)\\bBY\\b"
        },
        {
          "name": "keyword.control.loop.topsy",
          "match": "(?i)\\bUNTIL\\b"
        },
        {
          "name": "keyword.control.loop.topsy",
          "match": "(?i)\\bWHILST\\b"
        },
        {
          "name": "keyword.control.loop.topsy",
          "match": "(?i)\\bTHE\\s+TERM\\s+EXPIRES\\."
        },
        {
          "name": "keyword.control.loop.topsy",
          "match": "(?i)\\bTHAT\\s+WILL\\s+DO\\."
        },
        {
          "name": "keyword.control.loop.topsy",
          "match": "(?i)\\bONCE\\s+MORE\\."
        }
      ]
    },
    "exceptions": {
      "patterns": [
        {
          "name": "keyword.control.exception.topsy",
          "match": "(?i)\\bTHE\\s+LAW\\s+IS\\b"
        },
        {
          "name": "keyword.control.exception.topsy",
          "match": "(?i)\\bA\\s+HIDEOUS\\s+CURSE\\s+ON\\b"
        },
        {
          "name": "keyword.control.exception.topsy",
          "match": "(?i)\\bWITH\\s+THE\\s+GREATEST\\s+RESPECT,"
        },
        {
          "name": "keyword.control.exception.topsy",
          "match": "(?i)\\bWITH\\s+GRATITUDE\\b"
        },
        {
          "name": "keyword.control.exception.topsy",
          "match": "(?i)\\bMODIFIED\\s+RAPTURE,?"
        },
        {
          "name": "keyword.control.exception.topsy",
          "match": "(?i)\\bTHAT\\s+CONCLUDES\\s+THE\\s+MATTER\\."
        },
        {
          "name": "keyword.control.exception.topsy",
          "match": "(?i)\\bTHAT\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "keyword.other.function.topsy",
          "match": "(?i)\\bIT\\s+IS\\s+MY\\s+DUTY\\s+TO\\s+PERFORM\\b"
        },
        {
          "name": "keyword.other.function.topsy",
          "match": "(?i)\\bUNDER\\s+THE\\s+TERMS\\s+OF\\b"
        },
        {
          "name": "keyword.other.function.topsy",
          "match": "(?i)\\bUNDER\\s+NO\\s+OBLIGATION\\b"
        },
        {
          "name": "keyword.other.function.topsy",
          "match": "(?i)\\bMY\\s+DUTY\\s+IS\\s+DISCHARGED\\."
        },
        {
          "name": "keyword.other.function.topsy",
          "match": "(?i)\\bMY\\s+DUTY\\s+IS\\s+PREMATURELY\\s+DISCHARGED\\."
        },
        {
          "name": "keyword.other.function.topsy",
          "match": "(?i)\\bAND\\s+SO\\s+I\\s+FIND\\b"
        },
        {
          "name": "keyword.other.function.topsy",
          "match": "(?i)\\bSUMMON\\b"
        },
        {
          "name": "keyword.other.function.topsy",
          "match": "(?i)\\bWITH\\s+DUTY\\b"
        },
        {
          "name": "keyword.other.function.topsy",
          "match": "(?i)\\bIF\\s+YOU\\s+PLEASE\\."
        },
        {
          "name": "keyword.other.function.topsy",
          "match": "(?i)\\bTO\\s+FIND\\b"
        }
      ]
    },
    "io": {
      "patterns": [
        {
          "name": "support.function.topsy",
          "match": "(?i)\\bBEHOLD\\b"
        },
        {
          "name": "support.function.topsy",
          "match": "(?i)\\bPRAY\\s+TELL\\b"
        },
        {
          "name": "support.function.topsy",
          "match": "(?i)\\bWITHOUT\\s+CEREMONY\\b"
        }
      ]
    },
    "import": {
      "name": "keyword.control.import.topsy",
      "match": "(?i)\\bPRAY\\s+ADMIT\\b"
    },
    "namespace": {
      "patterns": [
        {
          "name": "keyword.control.namespace.topsy",
          "match": "(?i)\\bTOWN\\b"
        },
        {
          "name": "keyword.control.namespace.topsy",
          "match": "(?i)\\bWITH\\s+DISTRICT\\b"
        },
        {
          "name": "keyword.control.namespace.topsy",
          "match": "(?i)\\bPRAY\\s+RECOGNISE\\b"
        }
      ]
    },
    "cast": {
      "patterns": [
        {
          "name": "keyword.operator.cast.topsy",
          "match": "(?i)\\bAS\\s+IT\\s+WERE\\b"
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "name": "keyword.other.declaration.topsy",
          "match": "(?i)\\bPRAY\\s+WELCOME\\b"
        },
        {
          "name": "keyword.other.declaration.topsy",
          "match": "(?i)\\bAS\\s+A\\b"
        },
        {
          "name": "keyword.other.declaration.topsy",
          "match": "(?i)\\bBEING\\b"
        },
        {
          "name": "keyword.other.declaration.topsy",
          "match": "(?i)\\bCONSERVATIVE\\b"
        },
        {
          "name": "keyword.other.declaration.topsy",
          "match": "(?i)\\bLIBERAL\\b"
        },
        {
          "name": "keyword.other.declaration.topsy",
          "match": "(?i)\\bSTANDING\\b"
        }
      ]
    },
    "assignment": {
      "name": "keyword.operator.assignment.topsy",
      "match": "(?i)\\bIS\\s+APPOINTED\\b"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.topsy",
          "match": "(?i)\\bLITTLE\\s+LIST\\s+OF\\b"
        },
        {
          "name": "storage.type.topsy",
          "match": "(?i)\\b(PEER|CHANCELLOR|PIRATE|SAUSAGE-ROLL|FATHOM|FOOT|YARN|STITCH|DECREE)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bWOVEN\\s+OF\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bHARDLY\\s+EVER\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bLOWER\\s+DEGREE\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bALL\\s+OF\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bANY\\s+OF\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bBOTH\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bEITHER\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bOR\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\b(SUM|DIFFERENCE|PRODUCT|QUOTIENT|REMAINDER|LARGER|SMALLER)\\s+OF\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\b(ALIKE|UNLIKE|PRE-ADAMITE)\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\b(CHORD|HARMONY|DISCORD|INVERSION)\\s+OF\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bTRANSPOSITION\\s+(UP|DOWN)\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bAND\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bVICTIM\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bON\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bRECKONING\\s+OF\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bWITH\\s+NOTHING\\b"
        },
        {
          "name": "keyword.operator.topsy",
          "match": "(?i)\\bWITH\\b"
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.topsy",
      "match": "(?i)\\b[A-Za-z][A-Za-z0-9_-]*\\b"
    }
  }
}
