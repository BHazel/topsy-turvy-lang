{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "UtopIR",
  "scopeName": "source.utopir",
  "fileTypes": ["utopir"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#char-literals" },
    { "include": "#numbers" },
    { "include": "#boolean-literals" },
    { "include": "#naught-literal" },
    { "include": "#array" },
    { "include": "#pointer" },
    { "include": "#declaration" },
    { "include": "#assignment" },
    { "include": "#cast" },
    { "include": "#arithmetic-float" },
    { "include": "#arithmetic-integer" },
    { "include": "#bitwise" },
    { "include": "#comparison-float" },
    { "include": "#comparison-integer" },
    { "include": "#logical" },
    { "include": "#stack" },
    { "include": "#summon-find" },
    { "include": "#summon" },
    { "include": "#control-flow" },
    { "include": "#victim" },
    { "include": "#functions" },
    { "include": "#array-types" },
    { "include": "#types" },
    { "include": "#variables" },
    { "include": "#parameters" },
    { "include": "#labels" },
    { "include": "#function-references" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.utopir",
      "match": "@.*$"
    },
    "strings": {
      "name": "string.quoted.double.utopir",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.utopir",
          "match": "~[nt\"~]"
        }
      ]
    },
    "char-literals": {
      "name": "string.quoted.single.utopir",
      "match": "'(?:(~[nt'~])|[^'])'",
      "captures": {
        "1": { "name": "constant.character.escape.utopir" }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.utopir",
          "match": "(?i)-?\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.utopir",
          "match": "(?i)-?\\b[0-9]+\\b"
        }
      ]
    },
    "boolean-literals": {
      "name": "constant.language.boolean.utopir",
      "match": "(?i)\\b(verity|nay)\\b"
    },
    "naught-literal": {
      "name": "constant.language.null.utopir",
      "match": "(?i)\\bnaught\\b"
    },
    "array": {
      "patterns": [
        {
          "name": "keyword.other.declaration.utopir",
          "match": "(?i)\\bwelcome\\.list\\b"
        },
        {
          "name": "keyword.operator.assignment.utopir",
          "match": "(?i)\\bappoint\\.victim\\b"
        }
      ]
    },
    "pointer": {
      "patterns": [
        {
          "name": "keyword.other.declaration.utopir",
          "match": "(?i)\\bwelcome\\.gallerypic\\b"
        },
        {
          "name": "keyword.other.access.utopir",
          "match": "(?i)\\b(pictureto|viewfrom|viewto)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.pointer.utopir",
          "match": "(?i)\\b(sum|diff)\\.g\\b"
        }
      ]
    },
    "declaration": {
      "name": "keyword.other.declaration.utopir",
      "match": "(?i)\\bwelcome\\b"
    },
    "assignment": {
      "name": "keyword.operator.assignment.utopir",
      "match": "(?i)\\bappoint\\b"
    },
    "cast": {
      "name": "keyword.operator.cast.utopir",
      "match": "(?i)\\bwere\\b"
    },
    "arithmetic-float": {
      "name": "keyword.operator.arithmetic.float.utopir",
      "match": "(?i)\\b(sum|diff|prod|quot|rem|max|min)\\.f\\b"
    },
    "arithmetic-integer": {
      "name": "keyword.operator.arithmetic.utopir",
      "match": "(?i)\\b(sum|diff|prod|quot|rem|max|min)\\b"
    },
    "bitwise": {
      "name": "keyword.operator.bitwise.utopir",
      "match": "(?i)\\b(chord|harmony|discord|inv|transup|transdown)\\b"
    },
    "comparison-float": {
      "name": "keyword.operator.comparison.float.utopir",
      "match": "(?i)\\b(alike|unlike|preadam|lowerdeg)\\.f\\b"
    },
    "comparison-integer": {
      "name": "keyword.operator.comparison.utopir",
      "match": "(?i)\\b(alike|unlike|preadam|lowerdeg)\\b"
    },
    "logical": {
      "name": "keyword.operator.logical.utopir",
      "match": "(?i)\\b(both|either|hardly)\\b"
    },
    "stack": {
      "name": "keyword.other.stack.utopir",
      "match": "(?i)\\b(prentice|leave)\\b"
    },
    "summon-find": {
      "name": "keyword.control.utopir",
      "match": "(?i)\\bsummon\\.find\\b"
    },
    "summon": {
      "name": "keyword.control.utopir",
      "match": "(?i)\\bsummon\\b"
    },
    "control-flow": {
      "name": "keyword.control.utopir",
      "match": "(?i)\\b(sailalike|sailunlike|sail|find)\\b"
    },
    "victim": {
      "name": "keyword.other.access.utopir",
      "match": "(?i)\\bvictim\\.(yarn|list)\\b"
    },
    "functions": {
      "patterns": [
        {
          "name": "keyword.control.utopir",
          "match": "(?i)\\b(duty|discharged)\\b"
        },
        {
          "name": "keyword.other.signature.utopir",
          "match": "(?i)\\b(term|finds)\\b"
        }
      ]
    },
    "array-types": {
      "name": "storage.type.utopir",
      "match": "(?i)\\blist\\.(chancellor|peer|pirate|sausageroll|standingchancellor|standingpeer|standingpirate|standingsausageroll|fathom|foot|decree|stitch|yarn)\\b"
    },
    "types": {
      "name": "storage.type.utopir",
      "match": "(?i)\\b(chancellor|peer|pirate|sausageroll|standingchancellor|standingpeer|standingpirate|standingsausageroll|fathom|foot|decree|stitch|yarn)\\b"
    },
    "variables": {
      "name": "variable.other.utopir",
      "match": "£[A-Za-z_][A-Za-z0-9_-]*"
    },
    "parameters": {
      "name": "variable.parameter.utopir",
      "match": "%[A-Za-z_][A-Za-z0-9_-]*"
    },
    "labels": {
      "name": "entity.name.label.utopir",
      "match": "![A-Za-z_][A-Za-z0-9_-]*"
    },
    "function-references": {
      "name": "entity.name.function.utopir",
      "match": "&[A-Za-z_][A-Za-z0-9_-]*(?:\\*[A-Za-z_][A-Za-z0-9_-]*)*"
    }
  }
}
