{
  "name": "topsy-turvy",
  "displayName": "Topsy Turvy",
  "description": "Language support for Topsy Turvy (.topsy) files, including syntax highlighting and LSP diagnostics.",
  "version": "0.0.1",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:topsy-turvy"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "topsy-turvy",
        "aliases": ["Topsy Turvy", "topsy-turvy"],
        "extensions": [".topsy"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/topsy-turvy-file-icon.svg",
          "dark": "./images/topsy-turvy-file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "topsy-turvy",
        "scopeName": "source.topsy",
        "path": "./syntaxes/topsy-turvy.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Topsy Turvy",
      "properties": {
        "topsy-turvy.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Topsy Turvy language server executable. Leave empty to use the default path resolved from topsy-turvy.buildConfiguration."
        },
        "topsy-turvy.buildConfiguration": {
          "type": "string",
          "default": "Debug",
          "enum": ["Debug", "Release"],
          "description": "Build configuration used when locating the language server and CLI binaries (Debug or Release). Ignored when the respective path override is set."
        },
        "topsy-turvy.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Topsy Turvy CLI executable. Leave empty to use the default path resolved from topsy-turvy.buildConfiguration."
        }
      }
    },
    "commands": [
      {
        "command": "topsy-turvy.runFile",
        "title": "Perform Topsy Turvy File",
        "icon": "$(play)",
        "category": "Topsy Turvy"
      },
      {
        "command": "topsy-turvy.stopFile",
        "title": "Interrupt Topsy Turvy File",
        "icon": "$(debug-stop)",
        "category": "Topsy Turvy"
      }
    ],
    "keybindings": [
      {
        "command": "topsy-turvy.runFile",
        "key": "F5",
        "when": "editorLangId == topsy-turvy && !topsyTurvyRunning"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "topsy-turvy.runFile",
          "when": "editorLangId == topsy-turvy && !topsyTurvyRunning",
          "group": "navigation"
        },
        {
          "command": "topsy-turvy.stopFile",
          "when": "topsyTurvyRunning",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "topsy-turvy.runFile",
          "when": "resourceExtname == .topsy && !topsyTurvyRunning",
          "group": "1_run@1"
        },
        {
          "command": "topsy-turvy.stopFile",
          "when": "resourceExtname == .topsy && topsyTurvyRunning",
          "group": "1_run@1"
        }
      ],
      "explorer/context": [
        {
          "command": "topsy-turvy.runFile",
          "when": "resourceExtname == .topsy && !topsyTurvyRunning",
          "group": "1_run@1"
        }
      ]
    },
    "semanticTokenScopes": [
      {
        "language": "topsy-turvy",
        "scopes": {
          "variable":  ["variable.other.readwrite"],
          "parameter": ["variable.parameter"],
          "function":  ["entity.name.function"]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
