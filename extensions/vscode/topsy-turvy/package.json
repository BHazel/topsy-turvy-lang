{
  "name": "topsy-turvy",
  "publisher": "bwhazel",
  "displayName": "Topsy Turvy",
  "description": "Rich language support for Topsy Turvy (.topsy) files, including syntax highlighting, completions and more.",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhazel/topsy-turvy-lang.git"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:topsy-turvy"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "topsy-turvy",
        "aliases": [
          "Topsy Turvy",
          "topsy-turvy"
        ],
        "extensions": [
          ".topsy"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/topsy-turvy-file-icon.svg",
          "dark": "./images/topsy-turvy-file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "topsy-turvy",
        "scopeName": "source.topsy",
        "path": "./syntaxes/topsy-turvy.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Topsy Turvy",
      "properties": {
        "topsy-turvy.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Topsy Turvy CLI executable. Leave empty to use the bundled binary."
        },
        "topsy-turvy.commandLineArguments": {
          "type": "string",
          "default": "",
          "description": "Command-line arguments passed to the Perform command (space-separated). Can also be set via the 'Set Command-Line Arguments' command."
        },
        "topsy-turvy.performTiptoeMode": {
          "type": "boolean",
          "default": false,
          "description": "Run the 'perform' command with the '--tiptoe' flag."
        },
        "topsy-turvy.rehearseTiptoeMode": {
          "type": "boolean",
          "default": false,
          "description": "Run the 'rehearse' command with the '--tiptoe' flag."
        },
        "topsy-turvy.cadenzaTiptoeMode": {
          "type": "boolean",
          "default": false,
          "description": "Start the Cadenza REPL with the '--tiptoe' flag"
        },
        "topsy-turvy.playbillRenderMarkdown": {
          "type": "boolean",
          "default": true,
          "description": "Open the generated documentation in the built-in Markdown preview.  When unchecked, the raw Markdown source is shown in a new editor tab instead."
        },
        "topsy-turvy.commissionSkipSubtitle": {
          "type": "boolean",
          "default": false,
          "description": "Skip the subtitle input step when commissioning a new file."
        },
        "topsy-turvy.mountSkipSubtitle": {
          "type": "boolean",
          "default": false,
          "description": "Skip the subtitle input step when mounting a new project."
        }
      }
    },
    "commands": [
      {
        "command": "topsy-turvy.runFile",
        "title": "Perform Topsy Turvy File",
        "icon": "$(play)",
        "category": "Topsy Turvy"
      },
      {
        "command": "topsy-turvy.stopFile",
        "title": "Interrupt Topsy Turvy File",
        "icon": "$(debug-stop)",
        "category": "Topsy Turvy"
      },
      {
        "command": "topsy-turvy.setCommandLineArgs",
        "title": "Set Command-Line Arguments",
        "category": "Topsy Turvy"
      },
      {
        "command": "topsy-turvy.rehearseFile",
        "title": "Rehearse Topsy Turvy File",
        "icon": "$(check)",
        "category": "Topsy Turvy"
      },
      {
        "command": "topsy-turvy.startCadenza",
        "title": "Start Cadenza REPL",
        "icon": "$(terminal)",
        "category": "Topsy Turvy"
      },
      {
        "command": "topsy-turvy.commissionFile",
        "title": "Commission New Topsy Turvy File",
        "icon": "$(new-file)",
        "category": "Topsy Turvy"
      },
      {
        "command": "topsy-turvy.cuePreProcessor",
        "title": "Cue the Pre-Processor",
        "icon": "$(filter)",
        "category": "Topsy Turvy"
      },
      {
        "command": "topsy-turvy.mountProject",
        "title": "Mount a New Topsy Turvy Project",
        "icon": "$(folder)",
        "category": "Topsy Turvy"
      },
      {
        "command": "topsy-turvy.generatePlaybill",
        "title": "Generate Playbill Code Documentation",
        "icon": "$(book)",
        "category": "Topsy Turvy"
      },
      {
        "command": "topsy-turvy.viewAstPromptbook",
        "title": "View the AST Promptbook",
        "icon": "$(json)",
        "category": "Topsy Turvy"
      }
    ],
    "keybindings": [
      {
        "command": "topsy-turvy.runFile",
        "key": "F5",
        "when": "editorLangId == topsy-turvy && !topsyTurvyRunning"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "topsy-turvy.runFile",
          "when": "editorLangId == topsy-turvy && !topsyTurvyRunning",
          "group": "navigation"
        },
        {
          "command": "topsy-turvy.stopFile",
          "when": "topsyTurvyRunning",
          "group": "navigation"
        },
        {
          "command": "topsy-turvy.rehearseFile",
          "when": "editorLangId == topsy-turvy && !topsyTurvyRunning",
          "group": "navigation"
        },
        {
          "command": "topsy-turvy.startCadenza",
          "when": "editorLangId == topsy-turvy",
          "group": "navigation"
        },
        {
          "command": "topsy-turvy.cuePreProcessor",
          "when": "editorLangId == topsy-turvy",
          "group": "navigation"
        },
        {
          "command": "topsy-turvy.generatePlaybill",
          "when": "editorLangId == topsy-turvy",
          "group": "navigation"
        },
        {
          "command": "topsy-turvy.viewAstPromptbook",
          "when": "editorLangId == topsy-turvy",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "topsy-turvy.runFile",
          "when": "resourceExtname == .topsy && !topsyTurvyRunning",
          "group": "1_run@1"
        },
        {
          "command": "topsy-turvy.stopFile",
          "when": "resourceExtname == .topsy && topsyTurvyRunning",
          "group": "1_run@1"
        },
        {
          "command": "topsy-turvy.rehearseFile",
          "when": "resourceExtname == .topsy && !topsyTurvyRunning",
          "group": "1_run@2"
        },
        {
          "command": "topsy-turvy.cuePreProcessor",
          "when": "resourceExtname == .topsy",
          "group": "2_topsy-turvy@1"
        },
        {
          "command": "topsy-turvy.generatePlaybill",
          "when": "resourceExtname == .topsy",
          "group": "2_topsy-turvy@2"
        },
        {
          "command": "topsy-turvy.viewAstPromptbook",
          "when": "resourceExtname == .topsy",
          "group": "2_topsy-turvy@3"
        }
      ],
      "explorer/context": [
        {
          "command": "topsy-turvy.runFile",
          "when": "resourceExtname == .topsy && !topsyTurvyRunning",
          "group": "1_run@1"
        },
        {
          "command": "topsy-turvy.rehearseFile",
          "when": "resourceExtname == .topsy && !topsyTurvyRunning",
          "group": "1_run@2"
        },
        {
          "command": "topsy-turvy.cuePreProcessor",
          "when": "resourceExtname == .topsy",
          "group": "2_topsy-turvy@1"
        },
        {
          "command": "topsy-turvy.generatePlaybill",
          "when": "resourceExtname == .topsy",
          "group": "2_topsy-turvy@2"
        },
        {
          "command": "topsy-turvy.viewAstPromptbook",
          "when": "resourceExtname == .topsy",
          "group": "2_topsy-turvy@3"
        }
      ]
    },
    "semanticTokenScopes": [
      {
        "language": "topsy-turvy",
        "scopes": {
          "variable": [
            "variable.other.readwrite"
          ],
          "variable.readonly": [
            "variable.other.constant"
          ],
          "parameter": [
            "variable.parameter"
          ],
          "function": [
            "entity.name.function"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run prebuild:dotnet && npm run package",
    "prebuild:dotnet": "node scripts/publish-cli.mjs",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vscode-test",
    "test:grammar": "vscode-tmgrammar-test -g syntaxes/topsy-turvy.tmLanguage.json 'tests/grammar/*.topsy-test'",
    "test:unit": "mocha --ui tdd 'out/test/unit/**/*.test.js'",
    "test:integration": "vscode-test --config .vscode-test.integration.mjs",
    "test:all": "npm run compile-tests && npm run test:grammar && npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
