(* UtopIR Formal Grammar v0.0.1-preview3 *)
(* Based on UtopIR.md v0.0.1-preview3 *)

(*----------------------------------------------------------------------------*)
(* Lexical Tokens                                                              *)
(*----------------------------------------------------------------------------*)
Identifier      = ( "_" | [a-zA-Z] ), { [a-zA-Z0-9_-] } ;
(* UtopIR identifiers begin with a letter or underscore, followed by any mix of
   letters, digits, hyphens, and underscores.  Unlike Topsy Turvy identifiers,
   hyphens are unambiguous here because UtopIR arithmetic uses keyword mnemonics
   (sum, diff, prod, ...) rather than symbolic operators. *)

Variable        = "£", Identifier ;
(* The £ sigil is a dedicated prefix and is not considered part of Identifier.
   By convention (not a grammar requirement), temporary registers produced by
   the transformer begin with £_ (e.g. £_sum_Peer1_Peer2) to visually
   distinguish them from user-declared variables. *)

Label           = "!", Identifier ;
(* The ! sigil is a dedicated prefix and is not considered part of Identifier,
   mirroring Variable exactly.  A Label names a branch target, not a virtual
   register.  Indentation of the instructions following a label declaration
   is a documentation convention only, with no grammar significance: a label
   is a flat marker in the instruction sequence, introducing no block or
   scope of its own. *)

IntegerLiteral  = [ "-" ], Digit, { Digit } ;
FloatLiteral    = [ "-" ], Digit, { Digit }, ".", Digit, { Digit } ;
StringLiteral   = '"', { AnyCharExceptQuoteOrTilde | "~", AnyChar }, '"' ;
(* Escape sequences use the same ~ convention as Topsy Turvy: ~" for a literal
   double-quote, ~n for newline, ~t for horizontal tab, ~~ for a literal ~. *)
CharLiteral     = "'", ( AnyCharExceptSingleQuoteOrTilde | "~", AnyChar ), "'" ;
(* CharLiteral holds exactly one character or one escape sequence. *)
BooleanLiteral  = "verity" | "nay" ;
(* Boolean literals in UtopIR mirror Topsy Turvy's VERITY and NAY, lowercased:
   "verity" for true, "nay" for false. *)

NaughtLiteral   = "naught" ;
(* The null literal, assignable to a pointer, array or yarn variable. *)

Comment         = "@", { AnyCharExceptNewline } ;
(* A comment spans from @ to the end of the current line and is discarded by
   the parser. *)

Digit           = [0-9] ;

(*----------------------------------------------------------------------------*)
(* Programme Structure                                                        *)
(*----------------------------------------------------------------------------*)
Programme       = { Line } ;
Line            = [ Instruction | Comment ], Newline ;
(* Blank lines and comment-only lines are permitted anywhere in a programme. *)

(*----------------------------------------------------------------------------*)
(* Instructions                                                               *)
(*----------------------------------------------------------------------------*)
Instruction     = AssignmentInstruction | StandaloneInstruction ;

(* Assignment form: £<var> = <rhs> *)
AssignmentInstruction = Variable, "=", AssignmentRhs ;
AssignmentRhs         = WelcomeListRhs
                      | WelcomeGallerypicRhs
                      | WelcomeRhs
                      | AppointRhs
                      | PicturetoRhs
                      | ViewfromRhs
                      | PointerArithmeticRhs
                      | ArithmeticRhs
                      | BitwiseRhs
                      | InvRhs
                      | ComparisonRhs
                      | LogicalRhs
                      | HardlyRhs
                      | WereRhs
                      | LeaveRhs
                      | VictimYarnRhs
                      | VictimListRhs ;

WelcomeListRhs  = "welcome.list", Type, ",", IntegerLiteral ;
(* Declares an array variable of the given element Type and size.  Tried
   before WelcomeRhs, since "welcome" is a prefix of "welcome.list". *)
WelcomeGallerypicRhs = "welcome.gallerypic", Type ;
(* Declares a pointer variable of the given pointee Type.  Tried before
   WelcomeRhs, since "welcome" is a prefix of "welcome.gallerypic". *)
WelcomeRhs      = "welcome", Type ;
AppointRhs      = "appoint", Operand ;
PicturetoRhs    = "pictureto", Variable ;
(* Assigns the pointer to refer to the already-declared variable named by
   Variable. *)
ViewfromRhs     = "viewfrom", Variable ;
(* Dereferences the pointer named by Variable and assigns the value it
   refers to. *)
PointerArithmeticRhs = PointerArithmeticOp, Variable, ",", Operand ;
(* Adjusts the pointer named by Variable by the given integer offset.  Tried
   before ArithmeticRhs, defensively, for consistency with the
   longest/most-specific-mnemonic-first discipline used elsewhere. *)
ArithmeticRhs   = ArithmeticOp, Operand, ",", Operand ;
BitwiseRhs      = BitwiseOp, Operand, ",", Operand ;
InvRhs          = "inv", Operand ;
ComparisonRhs   = ComparisonOp, Operand, ",", Operand ;
LogicalRhs      = LogicalOp, Operand, ",", Operand ;
HardlyRhs       = "hardly", Operand ;
WereRhs         = "were", Operand, ",", Type ;
LeaveRhs        = "leave" ;
VictimYarnRhs   = "victim.yarn", Operand, ",", Operand ;
(* Selects the stitch character at the 1-based Operand index of a yarn value
   (the first Operand).  The target register is of type stitch. *)
VictimListRhs   = "victim.list", Variable, ",", Operand ;
(* Selects the element at the 1-based Operand index of the array named by
   Variable.  The target register has the array's declared element type. *)

(* Standalone form: no assignment target *)
StandaloneInstruction = PrenticeInstruction
                      | FindInstruction
                      | SailAlikeInstruction
                      | SailUnlikeInstruction
                      | SailInstruction
                      | AppointVictimInstruction
                      | ViewToInstruction
                      | LabelDeclaration ;
PrenticeInstruction   = "prentice", Operand ;
FindInstruction       = "find", [ Operand ] ;
(* When no token follows "find" before the next newline or EOF the instruction
   is a void return; when an Operand follows it is a valued return.  The parser
   commits to "no operand" on encountering a newline or EOF immediately after
   the "find" keyword. *)

SailInstruction       = "sail", Label ;
SailAlikeInstruction  = "sailalike", Operand, ",", Label ;
SailUnlikeInstruction = "sailunlike", Operand, ",", Label ;
(* "sailalike" and "sailunlike" must be matched before the plain "sail" form,
   since "sail" is a prefix of both mnemonics. *)

AppointVictimInstruction = "appoint.victim", Variable, ",", Operand, ",", Operand ;
(* Assigns Value (the second Operand) to the element at the 1-based index
   given by the first Operand, of the array named by Variable. *)

ViewToInstruction = "viewto", Variable, ",", Operand ;
(* Assigns Value (the Operand) through the pointer named by Variable,
   replacing the value it refers to. *)

LabelDeclaration      = Label ;
(* A bare Label on its own line declares a branch target at that position in
   the instruction sequence. *)

(*----------------------------------------------------------------------------*)
(* Operands                                                                   *)
(*----------------------------------------------------------------------------*)
Operand         = Variable | Literal ;
Literal         = IntegerLiteral
                | FloatLiteral
                | StringLiteral
                | CharLiteral
                | BooleanLiteral
                | NaughtLiteral ;

(*----------------------------------------------------------------------------*)
(* Arithmetic Operations                                                      *)
(*----------------------------------------------------------------------------*)
ArithmeticOp    = IntegerArithmeticOp | FloatArithmeticOp ;

IntegerArithmeticOp = "sum" | "diff" | "prod" | "quot" | "rem" | "max" | "min" ;

FloatArithmeticOp   = "sum.f" | "diff.f" | "prod.f" | "quot.f" | "rem.f"
                    | "max.f" | "min.f" ;
(* Floating-point arithmetic instructions carry the same names as their integer
   counterparts with a .f suffix.  A parser must match the .f form before the
   plain form, since the plain mnemonic is a prefix of its .f counterpart. *)

PointerArithmeticOp = "sum.g" | "diff.g" ;
(* Pointer arithmetic operands are (pointer, integer offset), a different
   shape to ArithmeticOp's same-type operand pair, so this is kept as its own
   production rather than folded into ArithmeticOp. *)

(*----------------------------------------------------------------------------*)
(* Bitwise Operations                                                         *)
(*----------------------------------------------------------------------------*)
BitwiseOp       = "chord" | "harmony" | "discord" | "transup" | "transdown" ;
(* All bitwise operations require integer operands.  The unary bitwise NOT,
   "inv", has its own single-operand rule (InvRhs) rather than appearing here.
   For the shifts, the second operand is the shift amount; Topsy Turvy's
   transposition operators default to a shift of one but accept an optional
   "BY <expr>" clause to explicitly set it, lowering directly to this same
   two-operand form. *)

(*----------------------------------------------------------------------------*)
(* Comparison Operations                                                      *)
(*----------------------------------------------------------------------------*)
ComparisonOp    = IntegerComparisonOp | FloatComparisonOp ;

IntegerComparisonOp = "alike" | "unlike" | "preadam" | "lowerdeg" ;

FloatComparisonOp   = "alike.f" | "unlike.f" | "preadam.f" | "lowerdeg.f" ;
(* Floating-point comparison instructions carry the same names as their
   integer counterparts with a .f suffix, mirroring ArithmeticOp.  A parser
   must match the .f form before the plain form, since the plain mnemonic is
   a prefix of its .f counterpart.  A comparison result is always of type
   decree, regardless of the operand type. *)

(*----------------------------------------------------------------------------*)
(* Logical Operations                                                         *)
(*----------------------------------------------------------------------------*)
LogicalOp       = "both" | "either" ;
(* Both operands, and the result, are of type decree.  The unary logical NOT,
   "hardly", has its own single-operand rule (HardlyRhs) rather than
   appearing here, mirroring how InvRhs stands apart from BitwiseOp. *)

(*----------------------------------------------------------------------------*)
(* Types                                                                      *)
(*----------------------------------------------------------------------------*)
Type            = SignedIntegerType
                | UnsignedIntegerType
                | FloatType
                | "decree"
                | "stitch"
                | "yarn" ;

SignedIntegerType   = "chancellor" | "peer" | "pirate" | "sausageroll" ;

UnsignedIntegerType = "standingchancellor" | "standingpeer"
                    | "standingpirate"     | "standingsausageroll" ;
(* Unsigned types are single compound tokens — "standing" is fused directly to
   the base type name with no whitespace, e.g. standingpeer, not "standing peer".
   This mirrors the Topsy Turvy convention of "STANDING PEER" collapsing to
   a single UtopIR keyword. *)

FloatType           = "fathom" | "foot" ;

(*----------------------------------------------------------------------------*)
(* Control Flow                                                               *)
(*----------------------------------------------------------------------------*)
(* See SailInstruction, SailAlikeInstruction, SailUnlikeInstruction and
   LabelDeclaration under Instructions, and Label under Lexical Tokens.  The
   value operand of SailAlikeInstruction and SailUnlikeInstruction must be of
   type decree; any other type is a compilation error. *)
