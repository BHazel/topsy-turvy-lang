(* UtopIR Formal Grammar v0.0.1-preview2 *)
(* Based on UtopIR.md v0.0.1-preview2 *)

(*----------------------------------------------------------------------------*)
(* Lexical Tokens                                                              *)
(*----------------------------------------------------------------------------*)
Identifier      = ( "_" | [a-zA-Z] ), { [a-zA-Z0-9_-] } ;
(* UtopIR identifiers begin with a letter or underscore, followed by any mix of
   letters, digits, hyphens, and underscores.  Unlike Topsy Turvy identifiers,
   hyphens are unambiguous here because UtopIR arithmetic uses keyword mnemonics
   (sum, diff, prod, ...) rather than symbolic operators. *)

Variable        = "£", Identifier ;
(* The £ sigil is a dedicated prefix and is not considered part of Identifier.
   By convention (not a grammar requirement), temporary registers produced by
   the transformer begin with £_ (e.g. £_sum_Peer1_Peer2) to visually
   distinguish them from user-declared variables. *)

IntegerLiteral  = [ "-" ], Digit, { Digit } ;
FloatLiteral    = [ "-" ], Digit, { Digit }, ".", Digit, { Digit } ;
StringLiteral   = '"', { AnyCharExceptQuoteOrTilde | "~", AnyChar }, '"' ;
(* Escape sequences use the same ~ convention as Topsy Turvy: ~" for a literal
   double-quote, ~n for newline, ~t for horizontal tab, ~~ for a literal ~. *)
CharLiteral     = "'", ( AnyCharExceptSingleQuoteOrTilde | "~", AnyChar ), "'" ;
(* CharLiteral holds exactly one character or one escape sequence. *)
BooleanLiteral  = "verity" | "nay" ;
(* Boolean literals in UtopIR mirror Topsy Turvy's VERITY and NAY, lowercased:
   "verity" for true, "nay" for false. *)

Comment         = "@", { AnyCharExceptNewline } ;
(* A comment spans from @ to the end of the current line and is discarded by
   the parser. *)

Digit           = [0-9] ;

(*----------------------------------------------------------------------------*)
(* Programme Structure                                                        *)
(*----------------------------------------------------------------------------*)
Programme       = { Line } ;
Line            = [ Instruction | Comment ], Newline ;
(* Blank lines and comment-only lines are permitted anywhere in a programme. *)

(*----------------------------------------------------------------------------*)
(* Instructions                                                               *)
(*----------------------------------------------------------------------------*)
Instruction     = AssignmentInstruction | StandaloneInstruction ;

(* Assignment form: £<var> = <rhs> *)
AssignmentInstruction = Variable, "=", AssignmentRhs ;
AssignmentRhs         = WelcomeRhs
                      | AppointRhs
                      | ArithmeticRhs
                      | BitwiseRhs
                      | InvRhs
                      | WereRhs
                      | LeaveRhs ;

WelcomeRhs      = "welcome", Type ;
AppointRhs      = "appoint", Operand ;
ArithmeticRhs   = ArithmeticOp, Operand, ",", Operand ;
BitwiseRhs      = BitwiseOp, Operand, ",", Operand ;
InvRhs          = "inv", Operand ;
WereRhs         = "were", Operand, ",", Type ;
LeaveRhs        = "leave" ;

(* Standalone form: no assignment target *)
StandaloneInstruction = PrenticeInstruction | FindInstruction ;
PrenticeInstruction   = "prentice", Operand ;
FindInstruction       = "find", [ Operand ] ;
(* When no token follows "find" before the next newline or EOF the instruction
   is a void return; when an Operand follows it is a valued return.  The parser
   commits to "no operand" on encountering a newline or EOF immediately after
   the "find" keyword. *)

(*----------------------------------------------------------------------------*)
(* Operands                                                                   *)
(*----------------------------------------------------------------------------*)
Operand         = Variable | Literal ;
Literal         = IntegerLiteral
                | FloatLiteral
                | StringLiteral
                | CharLiteral
                | BooleanLiteral ;

(*----------------------------------------------------------------------------*)
(* Arithmetic Operations                                                      *)
(*----------------------------------------------------------------------------*)
ArithmeticOp    = IntegerArithmeticOp | FloatArithmeticOp ;

IntegerArithmeticOp = "sum" | "diff" | "prod" | "quot" | "rem" | "max" | "min" ;

FloatArithmeticOp   = "sum.f" | "diff.f" | "prod.f" | "quot.f" | "rem.f"
                    | "max.f" | "min.f" ;
(* Floating-point arithmetic instructions carry the same names as their integer
   counterparts with a .f suffix.  A parser must match the .f form before the
   plain form, since the plain mnemonic is a prefix of its .f counterpart. *)

(*----------------------------------------------------------------------------*)
(* Bitwise Operations                                                         *)
(*----------------------------------------------------------------------------*)
BitwiseOp       = "chord" | "harmony" | "discord" | "transup" | "transdown" ;
(* All bitwise operations require integer operands.  The unary bitwise NOT,
   "inv", has its own single-operand rule (InvRhs) rather than appearing here.
   For the shifts, the second operand is the shift amount; Topsy Turvy's
   transposition operators default to a shift of one but accept an optional
   "BY <expr>" clause to explicitly set it, lowering directly to this same
   two-operand form. *)

(*----------------------------------------------------------------------------*)
(* Types                                                                      *)
(*----------------------------------------------------------------------------*)
Type            = SignedIntegerType
                | UnsignedIntegerType
                | FloatType
                | "decree"
                | "stitch"
                | "yarn" ;

SignedIntegerType   = "chancellor" | "peer" | "pirate" | "sausageroll" ;

UnsignedIntegerType = "standingchancellor" | "standingpeer"
                    | "standingpirate"     | "standingsausageroll" ;
(* Unsigned types are single compound tokens — "standing" is fused directly to
   the base type name with no whitespace, e.g. standingpeer, not "standing peer".
   This mirrors the Topsy Turvy convention of "STANDING PEER" collapsing to
   a single UtopIR keyword. *)

FloatType           = "fathom" | "foot" ;
