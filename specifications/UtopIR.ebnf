(* UtopIR Formal Grammar v0.0.1-preview4 *)
(* Based on UtopIR.md v0.0.1-preview4 *)

(*----------------------------------------------------------------------------*)
(* Lexical Tokens                                                              *)
(*----------------------------------------------------------------------------*)
Identifier      = ( "_" | [a-zA-Z] ), { [a-zA-Z0-9_-] } ;
(* UtopIR identifiers begin with a letter or underscore, followed by any mix of
   letters, digits, hyphens, and underscores.  Unlike Topsy Turvy identifiers,
   hyphens are unambiguous here because UtopIR arithmetic uses keyword mnemonics
   (sum, diff, prod, ...) rather than symbolic operators. *)

Variable        = "£", Identifier ;
(* The £ sigil is a dedicated prefix and is not considered part of Identifier.
   By convention (not a grammar requirement), a temporary register introduced
   to hold an intermediate value begins with £_ (e.g. £_sum_Peer1_Peer2) to
   visually distinguish it from a user-declared variable. *)

Label           = "!", Identifier ;
(* The ! sigil is a dedicated prefix and is not considered part of Identifier,
   mirroring Variable exactly.  A Label names a branch target, not a virtual
   register.  Indentation of the instructions following a label declaration
   is a documentation convention only, with no grammar significance: a label
   is a flat marker in the instruction sequence, introducing no block or
   scope of its own. *)

FunctionReference = "&", Identifier, { "*", Identifier } ;
(* The & sigil is a dedicated prefix and is not considered part of Identifier,
   mirroring Label exactly.  A FunctionReference names a function to call via
   summon/summon.find, not a virtual register or a branch target.  A
   namespace-qualified reference is one or more Identifier segments joined by
   "*", e.g. &Aesthetic*Writing*ReadPoem for a function ReadPoem declared
   under a namespace with path Aesthetic*Writing; a bare reference is a
   single segment. *)

Parameter       = "%", Identifier ;
(* The % sigil is a dedicated prefix and is not considered part of Identifier,
   mirroring Variable exactly.  A Parameter names a function parameter, bound
   from the argument passed by the caller; it is never declared with
   "welcome" and is valid only within the body of the duty block that
   declares it. *)

IntegerLiteral  = [ "-" ], Digit, { Digit } ;
FloatLiteral    = [ "-" ], Digit, { Digit }, ".", Digit, { Digit } ;
StringLiteral   = '"', { AnyCharExceptQuoteOrTilde | "~", AnyChar }, '"' ;
(* Escape sequences use the same ~ convention as Topsy Turvy: ~" for a literal
   double-quote, ~n for newline, ~t for horizontal tab, ~~ for a literal ~. *)
CharLiteral     = "'", ( AnyCharExceptSingleQuoteOrTilde | "~", AnyChar ), "'" ;
(* CharLiteral holds exactly one character or one escape sequence. *)
BooleanLiteral  = "verity" | "nay" ;
(* Boolean literals in UtopIR mirror the VERITY and NAY literals of Topsy Turvy,
   lowercased: "verity" for true, "nay" for false. *)

NaughtLiteral   = "naught" ;
(* The null literal, assignable to a pointer, array or yarn variable. *)

Comment         = "@", { AnyCharExceptNewline } ;
(* A comment spans from @ to the end of the current line and carries no
   semantic meaning. *)

Digit           = [0-9] ;

(*----------------------------------------------------------------------------*)
(* Programme Structure                                                        *)
(*----------------------------------------------------------------------------*)
Programme       = { BlankLine }, FunctionDefinition,
                  { { BlankLine }, FunctionDefinition }, { BlankLine } ;
(* A programme is one or more duty ... discharged function definition blocks,
   separated by any number of blank/comment-only lines, to end-of-input.
   Every programme contains at least one FunctionDefinition named Opera, the
   implicit entry point wrapping every top-level Topsy Turvy statement (see
   UtopIR.md §1); user-declared functions appear alongside it. Unlike earlier
   grammar versions, a bare Instruction is never valid directly at the
   programme level: every instruction lives inside the body of some
   FunctionDefinition. *)

BlankLine       = [ Comment ], Newline ;
(* A line containing only optional leading/trailing whitespace and an
   optional Comment, with no Instruction. Permitted between function
   definitions, and, via Line below, within a function body. *)

Line            = [ Instruction | Comment ], Newline ;
(* Blank lines and comment-only lines are permitted anywhere within the
   body of a FunctionDefinition. *)

FunctionDefinition = DutyHeader, Newline, { Line }, Discharged, Newline ;
(* The duty header, then the function body (zero or more Line, exactly as
   within any instruction sequence), then the discharged closer.  The
   newline of the closer is consumed as part of this rule, mirroring how
   Line consumes its own trailing newline. *)

DutyHeader      = "duty", FunctionReference,
                  { ",", DutyParameter },
                  [ ",", Finds ] ;
(* The duty opener: duty &<fn-name>, [term <type> %<param-name>, ...] [finds <type>] *)

DutyParameter   = "term", TermType, Parameter ;
(* One term <type> %<param-name> entry in a duty header. *)

Finds           = "finds", TermType ;
(* The optional trailing return-type clause of a duty header; omitted
   entirely for a void function. *)

Discharged      = "discharged" ;
(* The function definition closer. *)

(*----------------------------------------------------------------------------*)
(* Instructions                                                               *)
(*----------------------------------------------------------------------------*)
Instruction     = AssignmentInstruction | StandaloneInstruction ;

(* Assignment form: £<var> = <rhs> *)
AssignmentInstruction = Variable, "=", AssignmentRhs ;
AssignmentRhs         = WelcomeListRhs
                      | WelcomeGallerypicRhs
                      | WelcomeRhs
                      | AppointRhs
                      | PicturetoRhs
                      | ViewfromRhs
                      | PointerArithmeticRhs
                      | ArithmeticRhs
                      | BitwiseRhs
                      | InvRhs
                      | ComparisonRhs
                      | LogicalRhs
                      | HardlyRhs
                      | WereRhs
                      | LeaveRhs
                      | VictimYarnRhs
                      | VictimListRhs
                      | SummonFindRhs ;

WelcomeListRhs  = "welcome.list", Type, ",", Operand ;
(* Declares an array variable of the given element Type and size.  The size
   Operand may be a literal or a variable already holding the desired size.
   Tried before WelcomeRhs, since "welcome" is a prefix of "welcome.list". *)
WelcomeGallerypicRhs = "welcome.gallerypic", Type ;
(* Declares a pointer variable of the given pointee Type.  Tried before
   WelcomeRhs, since "welcome" is a prefix of "welcome.gallerypic". *)
WelcomeRhs      = "welcome", Type ;
AppointRhs      = "appoint", Operand ;
PicturetoRhs    = "pictureto", Variable ;
(* Assigns the pointer to refer to the already-declared variable named by
   Variable. *)
ViewfromRhs     = "viewfrom", Variable ;
(* Dereferences the pointer named by Variable and assigns the value it
   refers to. *)
PointerArithmeticRhs = PointerArithmeticOp, Variable, ",", Operand ;
(* Adjusts the pointer named by Variable by the given integer offset.  Tried
   before ArithmeticRhs, defensively, for consistency with the
   longest/most-specific-mnemonic-first discipline used elsewhere. *)
ArithmeticRhs   = ArithmeticOp, Operand, ",", Operand ;
BitwiseRhs      = BitwiseOp, Operand, ",", Operand ;
InvRhs          = "inv", Operand ;
ComparisonRhs   = ComparisonOp, Operand, ",", Operand ;
LogicalRhs      = LogicalOp, Operand, ",", Operand ;
HardlyRhs       = "hardly", Operand ;
WereRhs         = "were", Operand, ",", Type ;
LeaveRhs        = "leave" ;
VictimYarnRhs   = "victim.yarn", Operand, ",", Operand ;
(* Selects the stitch character at the 1-based Operand index of a yarn value
   (the first Operand).  The target register is of type stitch. *)
VictimListRhs   = "victim.list", Variable, ",", Operand ;
(* Selects the element at the 1-based Operand index of the array named by
   Variable.  The target register has the declared element type of the array. *)

SummonFindRhs   = "summon.find", FunctionReference, Signature ;
(* Calls the named function and assigns its return value to the target
   register.  "summon" is a prefix of "summon.find", but the two do not
   share an alternative list in this grammar: SummonFindRhs is reachable
   only through AssignmentRhs, which requires a leading Variable "="
   already matched, while SummonInstruction (below) is reachable only
   through StandaloneInstruction, where no such prefix is present. *)

Signature       = { ",", SignatureTerm } ;
(* Zero or more trailing ", term <type>" entries, one per parameter in
   declaration order, used for overload resolution; empty for a
   parameterless function. *)

SignatureTerm   = "term", TermType ;
(* One entry of a summon/summon.find trailing signature clause. Unlike
   DutyParameter, carries no Parameter name, only the type. *)

(* Standalone form: no assignment target *)
StandaloneInstruction = PrenticeInstruction
                      | FindInstruction
                      | SailAlikeInstruction
                      | SailUnlikeInstruction
                      | SailInstruction
                      | SummonInstruction
                      | AppointVictimInstruction
                      | ViewToInstruction
                      | LabelDeclaration ;
PrenticeInstruction   = "prentice", Operand ;
FindInstruction       = "find", [ Operand ] ;
(* When no token follows "find" before the next newline or EOF the instruction
   is a void return; when an Operand follows it is a valued return.  A newline
   or end of input immediately following the "find" keyword resolves to the
   void form. *)

SailInstruction       = "sail", Label ;
SailAlikeInstruction  = "sailalike", Operand, ",", Label ;
SailUnlikeInstruction = "sailunlike", Operand, ",", Label ;
(* "sailalike" and "sailunlike" must be matched before the plain "sail" form,
   since "sail" is a prefix of both mnemonics. *)

SummonInstruction     = "summon", FunctionReference, Signature ;
(* Calls the named function, ignoring any return value.  See SummonFindRhs
   above for why "summon" and "summon.find" sharing a prefix does not
   require an ordering rule between them in this grammar. *)

AppointVictimInstruction = "appoint.victim", Variable, ",", Operand, ",", Operand ;
(* Assigns Value (the second Operand) to the element at the 1-based index
   given by the first Operand, of the array named by Variable. *)

ViewToInstruction = "viewto", Variable, ",", Operand ;
(* Assigns Value (the Operand) through the pointer named by Variable,
   replacing the value it refers to. *)

LabelDeclaration      = Label ;
(* A bare Label on its own line declares a branch target at that position in
   the instruction sequence. *)

(*----------------------------------------------------------------------------*)
(* Operands                                                                   *)
(*----------------------------------------------------------------------------*)
Operand         = Variable | Parameter | Literal ;
Literal         = IntegerLiteral
                | FloatLiteral
                | StringLiteral
                | CharLiteral
                | BooleanLiteral
                | NaughtLiteral ;

(*----------------------------------------------------------------------------*)
(* Arithmetic Operations                                                      *)
(*----------------------------------------------------------------------------*)
ArithmeticOp    = IntegerArithmeticOp | FloatArithmeticOp ;

IntegerArithmeticOp = "sum" | "diff" | "prod" | "quot" | "rem" | "max" | "min" ;

FloatArithmeticOp   = "sum.f" | "diff.f" | "prod.f" | "quot.f" | "rem.f"
                    | "max.f" | "min.f" ;
(* Floating-point arithmetic instructions carry the same names as their integer
   counterparts with a .f suffix.  The .f-suffixed form takes precedence over
   the plain form, since the plain mnemonic is a prefix of its .f counterpart. *)

PointerArithmeticOp = "sum.g" | "diff.g" ;
(* Pointer arithmetic operands are (pointer, integer offset), a different
   shape to the same-type operand pair of ArithmeticOp, so this is kept as
   its own production rather than folded into ArithmeticOp. *)

(*----------------------------------------------------------------------------*)
(* Bitwise Operations                                                         *)
(*----------------------------------------------------------------------------*)
BitwiseOp       = "chord" | "harmony" | "discord" | "transup" | "transdown" ;
(* All bitwise operations require integer operands.  The unary bitwise NOT,
   "inv", has its own single-operand rule (InvRhs) rather than appearing here.
   For the shifts, the second operand is the shift amount; the transposition
   operators of Topsy Turvy default to a shift of one but accept an optional
   "BY <expr>" clause to explicitly set it, lowering directly to this same
   two-operand form. *)

(*----------------------------------------------------------------------------*)
(* Comparison Operations                                                      *)
(*----------------------------------------------------------------------------*)
ComparisonOp    = IntegerComparisonOp | FloatComparisonOp ;

IntegerComparisonOp = "alike" | "unlike" | "preadam" | "lowerdeg" ;

FloatComparisonOp   = "alike.f" | "unlike.f" | "preadam.f" | "lowerdeg.f" ;
(* Floating-point comparison instructions carry the same names as their
   integer counterparts with a .f suffix, mirroring ArithmeticOp.  The
   .f-suffixed form takes precedence over the plain form, since the plain
   mnemonic is a prefix of its .f counterpart.  A comparison result is always
   of type decree, regardless of the operand type. *)

(*----------------------------------------------------------------------------*)
(* Logical Operations                                                         *)
(*----------------------------------------------------------------------------*)
LogicalOp       = "both" | "either" ;
(* Both operands, and the result, are of type decree.  The unary logical NOT,
   "hardly", has its own single-operand rule (HardlyRhs) rather than
   appearing here, mirroring how InvRhs stands apart from BitwiseOp. *)

(*----------------------------------------------------------------------------*)
(* Types                                                                      *)
(*----------------------------------------------------------------------------*)
Type            = SignedIntegerType
                | UnsignedIntegerType
                | FloatType
                | "decree"
                | "stitch"
                | "yarn" ;

SignedIntegerType   = "chancellor" | "peer" | "pirate" | "sausageroll" ;

UnsignedIntegerType = "standingchancellor" | "standingpeer"
                    | "standingpirate"     | "standingsausageroll" ;
(* Unsigned types are single compound tokens: "standing" is fused directly to
   the base type name with no whitespace, e.g. standingpeer, not "standing peer".
   This mirrors the Topsy Turvy convention of "STANDING PEER" collapsing to
   a single UtopIR keyword. *)

FloatType           = "fathom" | "foot" ;

TermType        = "list.", Type | Type ;
(* A type valid only in a term/finds signature position: a duty parameter, a
   duty return type, or a summon/summon.find signature clause. Not valid in a
   welcome/were/etc. type position. The "list.<type>" array form is tried
   first: "list." has no plain-Type counterpart it could be confused with,
   but the ordering still follows the longest/most-specific-first discipline
   used throughout this grammar. list.<type> cannot be used in a declaration
   or assignment instruction (see WelcomeListRhs, which carries its element
   Type and size separately instead). *)

(*----------------------------------------------------------------------------*)
(* Control Flow                                                               *)
(*----------------------------------------------------------------------------*)
(* See SailInstruction, SailAlikeInstruction, SailUnlikeInstruction and
   LabelDeclaration under Instructions, and Label under Lexical Tokens.  The
   value operand of SailAlikeInstruction and SailUnlikeInstruction must be of
   type decree; any other type is a compilation error. *)
