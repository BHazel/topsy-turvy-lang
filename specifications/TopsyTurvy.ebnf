(* Topsy Turvy Formal Grammar v0.7.0 *)

(*----------------------------------------------------------------------------*)
(* Lexical Tokens                                                              *)
(*----------------------------------------------------------------------------*)
Identifier    = [a-zA-Z], { [a-zA-Z0-9_-] } ;
StringLiteral = '"', { AnyCharExceptQuoteOrTilde | '~' AnyChar }, '"' ;
CharLit       = "'", ( AnyCharExceptSingleQuoteOrTilde | '~' AnyChar ), "'" ;
(* CharLit contains exactly one character or one escape sequence.  Escape sequences within
   a CharLit use the same ~ prefix as StringLiteral, except ~' for a literal single quote
   replaces ~" (which has no special meaning inside single quotes). *)
Integer       = [ "-" ], Digit, { Digit } ;
Float         = [ "-" ], Digit, { Digit }, ".", Digit, { Digit } ;
BooleanLit    = "VERITY" | "NAY" ;
NullLit       = "NAUGHT" ;

(*----------------------------------------------------------------------------*)
(* Program Structure                                                          *)
(*----------------------------------------------------------------------------*)
Program         = "HARK!", StringLiteral, [ "\n", "or,", StringLiteral ],
                  TopLevelStatementList, "FINALE." ;

TopLevelStatementList = { TopLevelStatement } ;

TopLevelStatement = ProgrammeReturn
                  | NamespaceDeclaration
                  | RecogniseStatement
                  | Statement ;
(* NamespaceDeclaration and RecogniseStatement are valid only directly within the top-level
   programme body, never inside a function, loop, conditional, or other block body — this is
   what makes namespace membership a whole-file property rather than a per-statement one; see
   §15 Libraries & Imports. ProgrammeReturn is likewise top-level-only; see §1 Program Structure. *)

ProgrammeReturn = "AND SO I FIND", Expression ;

StatementList   = { Statement } ;

Statement       = PrincipalBlock
                | PointerDeclaration
                | ArrayDeclaration
                | Declaration
                | DereferenceAssignment
                | ArrayAssignment
                | Assignment
                | PrintStatement
                | InputStatement
                | Conditional
                | Switch
                | Loop
                | GuardClause
                | FunctionDefinition
                | ImportStatement
                | TryCatchBlock
                | AssertStatement
                | ExpressionStatement ;

(*----------------------------------------------------------------------------*)
(* Declarations & Assignments                                                 *)
(*----------------------------------------------------------------------------*)
PrincipalBlock  = "PRINCIPALS", { PointerDeclaration | Declaration | ArrayDeclaration }, "THE CURTAIN RISES." ;

Declaration         = "PRAY WELCOME", Identifier, "AS A", [ MutabilityModifier ], ScalarType, [ "BEING", Expression ] ;

ArrayDeclaration    = "PRAY WELCOME", Identifier, "AS A", [ MutabilityModifier ], "LITTLE LIST OF", [ Integer ], ScalarType,
                      [ "BEING", Expression, { "AND", Expression }, "IF YOU PLEASE." ] ;
(* Note: "AS A LITTLE LIST OF" is the user-visible phrase; the parser consumes "AS A" first,
   leaving "LITTLE LIST OF" as the array-type marker.  The "A" is shared between the two tokens.
   The optional Integer pre-allocates that many NAUGHT elements; mutually exclusive with the BEING clause
   (providing both is a runtime error).  A negative Integer is also a runtime error. *)

PointerDeclaration  = "PRAY WELCOME", Identifier, "AS A", [ MutabilityModifier ], "GALLERY PICTURE OF", ScalarType,
                      [ "BEING", Expression ] ;
(* Note: "AS A GALLERY PICTURE OF" is the user-visible phrase; the parser consumes "AS A" first,
   leaving "GALLERY PICTURE OF" as the pointer-type marker, sharing the "A" the same way ArrayDeclaration
   does with "LITTLE LIST OF".  With no BEING clause the pointer defaults to NAUGHT (unassigned).  When
   present, the BEING expression must be an AddressOfExpression (or NAUGHT); this is a type-checker
   constraint, not a grammar one, since the grammar accepts any Expression in this position. *)

MutabilityModifier  = "CONSERVATIVE" | "LIBERAL" ;

BaseIntegerType = "PEER" | "CHANCELLOR" | "PIRATE" | "SAUSAGE-ROLL" ;

ScalarType      = BaseIntegerType
                | "STANDING", BaseIntegerType
                | "FATHOM" | "FOOT"
                | "YARN" | "STITCH"
                | "DECREE" ;
(* "STANDING" may only precede a BaseIntegerType.  Combining it with FATHOM, FOOT, YARN,
   STITCH or DECREE is a parse error. *)

ArrayType       = "LITTLE LIST OF", ScalarType ;
(* Appears after "AS A" in a declaration; the user writes "AS A LITTLE LIST OF <type>". *)

PointerType     = "GALLERY PICTURE OF", ScalarType ;
(* Appears after "AS A" in a declaration; the user writes "AS A GALLERY PICTURE OF <type>".  The
   pointee type is always a ScalarType: pointing at an array or YARN decays to the element/character
   type, and pointer-to-pointer is not supported. *)

Type            = ScalarType | ArrayType | PointerType ;

Assignment      = Identifier, "IS APPOINTED", Expression ;

ArrayAssignment = "VICTIM", Expression, "ON", Identifier, "IS APPOINTED", Expression ;

DereferenceAssignment = "VIEW FROM", Identifier, "IS APPOINTED", Expression ;

(*----------------------------------------------------------------------------*)
(* Expressions (Prefix Notation)                                              *)
(*----------------------------------------------------------------------------*)
Expression      = TernaryExpression
                | CastExpression
                | ArrayIndexExpression
                | ArrayLengthExpression
                | AddressOfExpression
                | DereferenceExpression
                | PrefixExpression
                | StringLiteral
                | CharLit
                | BooleanLit
                | NullLit
                | Integer
                | Float
                | Identifier ;

TernaryExpression = NonTernaryExpression, "SHOULD IT TRANSPIRE THAT", NonTernaryExpression,
                    "OTHERWISE,", Expression ;
(* NonTernaryExpression is any Expression alternative except TernaryExpression itself.
   TrueValue and Condition are restricted to NonTernaryExpression to avoid left-recursion
   and to prevent OTHERWISE, being consumed by a nested ternary in the condition position.
   FalseValue uses full Expression to allow right-chained ternaries. *)

NonTernaryExpression = CastExpression
                     | ArrayIndexExpression
                     | ArrayLengthExpression
                     | AddressOfExpression
                     | DereferenceExpression
                     | PrefixExpression
                     | StringLiteral
                     | CharLit
                     | BooleanLit
                     | NullLit
                     | Integer
                     | Float
                     | Identifier ;

ArrayIndexExpression = "VICTIM", Expression, "ON", Identifier ;

ArrayLengthExpression = "RECKONING OF", Identifier ;

AddressOfExpression = "GALLERY PICTURE TO", Identifier ;
(* <variable> must be an already-declared variable name; only a bare Identifier is accepted, so
   literals and arbitrary expressions are rejected by the grammar itself. *)

DereferenceExpression = "VIEW FROM", Identifier ;

CastExpression  = "AS IT WERE", Expression, "AS A", Type ;

PrefixExpression = EitherExpression | TranspositionExpression | OtherFixedOpExpression | VariadicExpression | FunctionCallExpression ;

EitherExpression       = "EITHER", Expression, "OR", Expression ;
(* EITHER is the sole binary operator that uses "OR" as its argument separator.
   All other fixed-arity operators use "AND", except TRANSPOSITION UP/DOWN below,
   which use "BY". *)

TranspositionExpression = TranspositionOp, Expression, [ "BY", Expression ] ;
(* TRANSPOSITION UP/DOWN default to a shift of 1; an optional BY <expr> clause
   overrides the shift amount.  BY is the sole argument separator for these two
   operators — AND is not accepted here, mirroring how EITHER does not accept AND. *)

OtherFixedOpExpression = OtherFixedOp, Expression, [ "AND", Expression ] ;
(* HARDLY EVER is unary so the second operand is optional. *)

VariadicExpression = VariadicOp, Expression, { "AND", Expression }, "IF YOU PLEASE." ;

FunctionCallExpression = "SUMMON", FunctionCallTarget, "WITH",
                         ( "NOTHING" | Expression, { "AND", Expression } ),
                         "IF YOU PLEASE." ;
(* Split out from VariadicExpression because, unlike WOVEN OF/ALL OF/ANY OF, SUMMON's first
   term is a call target (not itself an Expression) and takes the WITH .. IF YOU PLEASE. shape
   rather than a bare comma-like AND-list — mirroring how EitherExpression and
   TranspositionExpression are already split out of the generic operator productions. *)

FunctionCallTarget     = Identifier, FunctionCallTargetTail ;

FunctionCallTargetTail = { "WITH DISTRICT", Identifier }, "WITH DUTY", Identifier
                        | { "*", Identifier }
                        | (* empty: plain, non-namespaced call, e.g. SUMMON factorial WITH ... *) ;
(* The long-hand form (WITH DISTRICT chain then a mandatory WITH DUTY <name>) and the
   short-hand form (a *-joined qualified name) are two surface syntaxes for the same
   fully-qualified target — see §15 Libraries & Imports for the worked namespace examples.
   Once either form has matched at least one token, backtracking to the empty (plain-call)
   alternative is no longer permitted; a missing WITH DUTY after a WITH DISTRICT chain is a
   syntax error, not a fall-through. *)

OtherFixedOp    = ArithmeticOp | OtherBooleanOp | ComparisonOp | BitwiseOp ;

ArithmeticOp    = "SUM OF" | "DIFFERENCE OF" | "PRODUCT OF"
                | "QUOTIENT OF" | "REMAINDER OF" | "LARGER OF" | "SMALLER OF" ;

OtherBooleanOp  = "BOTH" | "HARDLY EVER" ;

ComparisonOp    = "ALIKE" | "UNLIKE" | "PRE-ADAMITE" | "LOWER DEGREE" ;

BitwiseOp       = "CHORD OF" | "HARMONY OF" | "DISCORD OF" | "INVERSION OF" ;

TranspositionOp = "TRANSPOSITION UP" | "TRANSPOSITION DOWN" ;

VariadicOp      = "WOVEN OF" | "ALL OF" | "ANY OF" ;

(*----------------------------------------------------------------------------*)
(* Control Flow                                                               *)
(*----------------------------------------------------------------------------*)
Conditional     = "SHOULD IT TRANSPIRE THAT", Expression,
                  IfBody, "SO MUCH FOR THAT." ;

IfBody          = "QUITE SO.", StatementList,
                  { "OR, IF NOT,", Expression, StatementList },
                  [ "OTHERWISE,", StatementList ] ;

Switch          = "IN WHICH CAPACITY?", Expression,
                  SwitchBody, "NOTHING COULD BE MORE SATISFACTORY." ;

SwitchBody      = { CaseLabel, [ StatementList ], [ "THAT WILL DO." ] }, 
                  [ "FAILING ALL OF THE ABOVE,", StatementList ] ;

CaseLabel       = "WHEN ACTING AS", Literal ;

Loop            = "BY A LEGAL FICTION", [ "KNOWN AS", Identifier ], 
                  LoopType, 
                  LoopBody, "THE TERM EXPIRES." ;

LoopType        = ( "ASCENDING", Identifier, "UNTIL", Expression )
                | ( "DESCENDING", Identifier, "UNTIL", Expression )
                | ( "WHILST", Expression )
                | ( (* Infinite loop *) ) ;

LoopBody       = { Statement | "ONCE MORE." | "THAT WILL DO." } ;

GuardClause     = "YEOMAN", Expression, "OTHERWISE,", StatementList, "UNDER ORDERS." ;
(* Executes StatementList only when Expression is falsy.  If truthy, execution falls through.
   YEOMAN is the guard opener; UNDER ORDERS. is the guard closer.  OTHERWISE, is the
   required block separator; the same keyword used by Conditional and TernaryExpression. *)

(*----------------------------------------------------------------------------*)
(* Functions & Exceptions                                                     *)
(*----------------------------------------------------------------------------*)
FunctionDefinition = "IT IS MY DUTY TO PERFORM", Identifier,
                    ( "UNDER THE TERMS OF", ParameterList | "UNDER NO OBLIGATION" ),
                    [ "TO FIND", Type ],
                    FunctionBody,
                    ( "MY DUTY IS DISCHARGED." | "MY DUTY IS PREMATURELY DISCHARGED." ) ;
(* TO FIND Type declares the return type.  Omitting it means the function is void —
   no AND SO I FIND expression is expected. *)

ParameterList      = TypedParameter, { "AND", TypedParameter } ;

TypedParameter     = Identifier, "AS A", Type ;

FunctionBody       = { Statement }, [ "AND SO I FIND", Expression ] ;

ImportStatement    = "PRAY ADMIT", StringLiteral ;

NamespaceDeclaration = "TOWN", NamespacePath ;
(* At most one per file, and valid only as a TopLevelStatement (see above) — the whole file's
   functions join this namespace, regardless of the declaration's position relative to them. *)

RecogniseStatement   = "PRAY RECOGNISE", NamespacePath ;
(* Opens a namespace so its functions may be called by bare name without a fully-qualified
   SUMMON target. May appear more than once, and does not itself require the target namespace's
   file to have been admitted via PRAY ADMIT in the same file. *)

NamespacePath        = Identifier, NamespaceTail ;

NamespaceTail        = { "WITH DISTRICT", Identifier }
                     | { "*", Identifier } ;
(* A path commits to one style — the long-hand WITH DISTRICT chain or the short-hand * chain —
   per declaration; the two styles are not mixed within a single TOWN or PRAY RECOGNISE. *)

AssertStatement    = "THE LAW IS", Expression, "THAT", Expression ;
(* If Expression (condition) is falsy, throws a runtime exception with the second Expression (error message)
   as the payload — same mechanism as A HIDEOUS CURSE ON.  THAT is a structural separator and is not
   listed in KeywordData to avoid polluting the LSP completion list. *)

TryCatchBlock      = "WITH THE GREATEST RESPECT,", Expression,
                    "WITH GRATITUDE", StatementList,
                    "MODIFIED RAPTURE,", Identifier, StatementList,
                    "THAT CONCLUDES THE MATTER." ;

(*----------------------------------------------------------------------------*)
(* Miscellaneous                                                               *)
(*----------------------------------------------------------------------------*)
PrintStatement     = "BEHOLD", Expression, [ "WITHOUT CEREMONY" ] ;

InputStatement     = "PRAY TELL", Identifier ;

ExpressionStatement = Expression ;

Literal            = StringLiteral | CharLit | Integer | Float | BooleanLit | NullLit ;

(*----------------------------------------------------------------------------*)
(* Documentation Comments                                                     *)
(*----------------------------------------------------------------------------*)
(* A documentation comment is an (ASIDE, AT SOME LENGTH: ... END OF ASIDE.)  *)
(* block placed immediately before a Declaration or FunctionDefinition.       *)
(* It carries no runtime semantics — it is stripped alongside all other block *)
(* comments and its content is read by tooling from the original source.      *)
(*                                                                             *)
(* Each keyword tag opens a section that continues until the next tag or the  *)
(* end of the block; any tag may therefore span multiple lines.               *)
(*                                                                             *)
(* A block with no recognised tags is treated as a plain block comment.       *)
(*                                                                             *)
DocComment         = "(ASIDE, AT SOME LENGTH:", DocCommentBody, "END OF ASIDE.)" ;
DocCommentBody     = { DocCommentLine | AnyChar } ;
DocCommentLine     = LegendLine | RecitativeLine | ArticleLine
                   | ConsequenceLine | CursesLine | ChorusSection
                   | EnsembleLine | StatutoryLine ;
LegendLine         = "LEGEND:", { AnyChar } ;
RecitativeLine     = "RECITATIVE:", { AnyChar } ;
ArticleLine        = "ARTICLE", Identifier, "(", Identifier, "):", { AnyChar } ;
ConsequenceLine    = "CONSEQUENCE", "(", Identifier, "):", { AnyChar } ;
CursesLine         = "CURSES", Identifier, "(", Identifier, "):", { AnyChar } ;
ChorusSection      = "CHORUS:", { AnyChar } ;
EnsembleLine       = "ENSEMBLE:", { AnyChar } ;
StatutoryLine      = "STATUTORY:", { AnyChar } ;

(*----------------------------------------------------------------------------*)
(* Runtime-Injected Built-In Variables                                        *)
(*----------------------------------------------------------------------------*)
(* The following identifier is not a grammar production — it is injected by  *)
(* the interpreter before execution begins and is always present.             *)
(*                                                                             *)
(* THE PROPS  : CONSERVATIVE LITTLE LIST OF YARN; contains the arguments      *)
(*              passed to the programme at invocation.  Empty array when none  *)
(*              are supplied.  1-based indexing; elements are always YARN.     *)
(*              Inaccessible inside functions per Invariant I7.                *)
(*                                                                             *)
(* THE PROPS may not be re-declared with PRAY WELCOME; doing so is a type    *)
(* error.                                                                      *)            *)
(*----------------------------------------------------------------------------*)
