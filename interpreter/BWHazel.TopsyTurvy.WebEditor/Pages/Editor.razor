@page "/"

@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<div class="editor-root">
    <MudPaper Elevation="1" Square="true" Class="flex-shrink-0">
        <MudToolBar Dense="true" Class="editor-toolbar">
            <MudButton Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.InsertDriveFile"
                       OnClick="ConfirmNewAsync">@(this.areGsLabelsEnabled ? "Commission" : "New")</MudButton>
            <MudButton Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.FolderOpen"
                       OnClick="OpenFileAsync">@(this.areGsLabelsEnabled ? "Recall" : "Open")</MudButton>
            <MudButton Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Save"
                       OnClick="SaveFileAsync">@(this.areGsLabelsEnabled ? "Pen" : "Save")</MudButton>
            <MudSpacer />
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       Disabled="isRunning"
                       OnClick="RunProgramAsync">@(this.areGsLabelsEnabled ? "Perform" : "Run")</MudButton>
            <MudSpacer />
            <MudTooltip Text="@(IsDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")">
                <MudIconButton Icon="@(IsDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                               OnClick="OnToggleDarkMode" />
            </MudTooltip>
            <MudTooltip Text="Clear Terminal Output">
                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                               Color="Color.Error"
                               OnClick="ConfirmClearAsync" />
            </MudTooltip>
            <MudTooltip Text="Download Terminal Output">
                <MudIconButton Icon="@Icons.Material.Outlined.FileDownload"
                               OnClick="DownloadTerminalAsync" />
            </MudTooltip>
            <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
            <MudSwitch T="bool"
                       @bind-Value="areGsLabelsEnabled"
                       Label="G&amp;S Labels"
                       Color="Color.Primary"
                       Class="mr-1" />
        </MudToolBar>
    </MudPaper>

    <div class="tab-bar-row">
        <MudTooltip Text="New File">
            <MudIconButton Icon="@Icons.Material.Filled.Add"
                           Size="Size.Small"
                           Class="tab-add-btn"
                           OnClick="NewFileAsync" />
        </MudTooltip>
        <MudTabs ActivePanelIndex="@this.ActiveTabIndex"
                 ActivePanelIndexChanged="OnTabIndexChangedAsync"
                 AlwaysShowScrollButtons="true"
                 Color="Color.Default"
                 Rounded="true"
                 Class="flex-1 min-width-0 tab-bar-tabs">
            @foreach (VirtualFile file in this.files)
            {
                <MudTabPanel Tag="@file.Name" PanelClass="d-none">
                    <TabContent>
                        <div class="d-flex align-center">
                            <span class="tab-filename">@file.Name</span>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                          Size="Size.Small"
                                          Class="tab-close-btn"
                                          OnClick="@(() => this.CloseFileAsync(file.Name))" />
                        </div>
                    </TabContent>
                </MudTabPanel>
            }
        </MudTabs>
    </div>

    <div class="panes-container">
        <div class="editor-pane">
            <StandaloneCodeEditor @ref="monacoEditor"
                                  Id="topsy-turvy-editor"
                                  CssClass="topsy-turvy-monaco"
                                  ConstructionOptions="GetEditorOptions"
                                  OnDidChangeModelContent="OnContentChangedAsync" />
        </div>
        <div class="output-pane">
            <div class="terminal-wrapper">
                <Xterm @ref="terminal" Options="terminalOptions" />
            </div>
            <MudTextField T="string"
                          @bind-Value="stdinText"
                          Label="Standard Input"
                          HelperText="One value per line"
                          Lines="2"
                          Variant="Variant.Outlined"
                          Class="ma-2" />
        </div>
    </div>
</div>

@code {
    private const string DefaultFileName = "programme.topsy";

    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; } = true;

    [CascadingParameter(Name = "ToggleDarkMode")]
    private Action? ToggleDarkMode { get; set; }

    private StandaloneCodeEditor? monacoEditor;
    private Xterm? terminal;
    private bool editorReady = false;
    private string stdinText = string.Empty;
    private bool isRunning = false;
    private string lastRunOutput = string.Empty;
    private bool previousIsDarkMode = true;
    private bool areGsLabelsEnabled = true;
    private CancellationTokenSource? cancellationTokenSource;

    private List<VirtualFile> files = [new(DefaultFileName)];
    private string activeFileName = DefaultFileName;

    private readonly TerminalOptions terminalOptions = new()
    {
        CursorBlink = false,
        ConvertEOL = true,
        Theme = new Theme
        {
            Background = "#1e1e1e",
            Foreground = "#d4d4d4",
        },
    };

    /// <summary>
    /// Gets the index of the currently active tab based on the active file name.
    /// </summary>
    private int ActiveTabIndex => Math.Max(0, this.files.FindIndex(file => file.Name == this.activeFileName));

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.applyLanguageToEditor", "topsy-turvy-editor");
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.setupTerminalFit");
            this.editorReady = true;
            this.previousIsDarkMode = IsDarkMode;
        }
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (this.editorReady && this.IsDarkMode != this.previousIsDarkMode)
        {
            previousIsDarkMode = this.IsDarkMode;
            await this.JSRuntime.InvokeVoidAsync("monaco.editor.setTheme", this.IsDarkMode ? "vs-dark" : "vs");
        }
    }

    /// <summary>
    /// Gets the options for the Monaco editor.
    /// </summary>
    /// <param name="editor">The Monaco editor.</param>
    /// <returns>Options for the Monaco editor.</returns>
    private StandaloneEditorConstructionOptions GetEditorOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions()
        {
            Language = "topsy-turvy",
            Theme = this.IsDarkMode
                ? "vs-dark"
                : "vs",
            AutomaticLayout = true,
            AutoIndent = "full",
            Value = string.Empty,
        };
    }

    /// <summary>
    /// Toggles between light and dark mode.
    /// </summary>
    private void OnToggleDarkMode() => this.ToggleDarkMode?.Invoke();

    /// <summary>
    /// Handles a tab index change from the tab bar.
    /// </summary>
    /// <param name="index">The new zero-based active tab index.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task OnTabIndexChangedAsync(int index)
    {
        if (index >= 0 && index < this.files.Count)
        {
            string name = this.files[index].Name;
            if (name != this.activeFileName)
            {
                await this.SwitchFileAsync(name);
            }
        }
    }

    /// <summary>
    /// Handles content changes in the editor.
    /// </summary>
    /// <param name="e">The event data for the content change.</param>
    /// <remarks>
    /// Includes a pause to avoid excessive parsing.
    /// </remarks>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task OnContentChangedAsync(ModelContentChangedEvent e)
    {
        this.cancellationTokenSource?.Cancel();
        this.cancellationTokenSource = new CancellationTokenSource();
        CancellationToken token = this.cancellationTokenSource.Token;

        try
        {
            await Task.Delay(400, token);
            string source = await this.JSRuntime.InvokeAsync<string>("blazorMonaco.editor.getValue", "topsy-turvy-editor", false, null);
            await this.UpdateDiagnosticsAsync(source);
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <summary>
    /// Updates the diagnostics in the editor based on the provided source code.
    /// </summary>
    /// <param name="source">The source code to analyze.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task UpdateDiagnosticsAsync(string source)
    {
        TopsyTurvyParser parser = new();
        ParseResult result = parser.TryParse(source);

        IEnumerable<object> markers = result.Diagnostics
            .Where(diagnostic => diagnostic.Severity == DiagnosticSeverity.Error)
            .Select(diagnostic => (object)new
            {
                startLineNumber = diagnostic.Span.Start.Line,
                startColumn = diagnostic.Span.Start.Column,
                endLineNumber = diagnostic.Span.End.Line,
                endColumn = diagnostic.Span.End.Column,
                message = diagnostic.Message,
                severity = 8,
            });

        await this.JSRuntime.InvokeVoidAsync("topsyTurvy.setModelMarkers", "topsy-turvy-editor", markers);
    }

    /// <summary>
    /// Runs the program currently in the editor, using the text from the standard input field as input.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task RunProgramAsync()
    {
        if (this.isRunning)
        {
            return;
        }

        isRunning = true;
        try
        {
            await this.RunProgramCoreAsync();
        }
        catch (Exception ex)
        {
            await this.JSRuntime.InvokeVoidAsync("console.error", "RunError: " + ex.GetType().Name + ": " + ex.Message);
        }
        finally
        {
            this.isRunning = false;
        }
    }

    /// <summary>
    /// Core logic for running a program.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task RunProgramCoreAsync()
    {
        await this.terminal!.Clear();
        await this.SyncActiveFileContentAsync();

        Dictionary<string, string> currentFileContents = this.files.ToDictionary(file => file.Name, file => file.Content);
        string source = currentFileContents[this.activeFileName];
        IEnumerable<string> stdinLines = this.stdinText.Split('\n');

        TopsyTurvyParser parser = new();
        ParseResult parseResult = parser.TryParse(source);

        if (!parseResult.Success)
        {
            foreach (Diagnostic diagnostic in parseResult.Diagnostics
                .Where(diagnostic => diagnostic.Severity == DiagnosticSeverity.Error))
            {
                await terminal!.WriteLine($"\x1b[31mSyntax error (line {diagnostic.Span.Start.Line}): {diagnostic.Message}\x1b[0m");
            }

            return;
        }

        BufferedWebIO io = new(stdinLines);

        using CancellationTokenSource cancellationTokenSource = new(TimeSpan.FromSeconds(10));
        Interpreter interpreter = new(io);
        Func<string, string?> fileResolver = name => currentFileContents.GetValueOrDefault(name);
        DiagnosticCollection runtimeDiagnostics = interpreter.Execute(
            parseResult.Program!,
            cancellationTokenSource.Token,
            TimeSpan.FromSeconds(10),
            fileResolver: fileResolver);

        foreach (string line in io.OutputLines)
        {
            await this.terminal!.WriteLine(line);
        }

        this.lastRunOutput = string.Join('\n', io.OutputLines);
        if (runtimeDiagnostics.HasErrors)
        {
            foreach (Diagnostic diagnostic in runtimeDiagnostics.Diagnostics
                .Where(diagnostic => diagnostic.Severity == DiagnosticSeverity.Error))
            {
                await this.terminal!.WriteLine($"\x1b[31mRuntime error: {diagnostic.Message}\x1b[0m");
            }
        }
    }

    /// <summary>
    /// Asks the user to confirm creating a new program, and if confirmed, resets the editor to a single blank file.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task ConfirmNewAsync()
    {
        bool? isNewConfirmed = await this.DialogService.ShowMessageBoxAsync(
            "Create New Programme",
            "Are you sure you want to start afresh?  This will close all files and is irreversible.",
            yesText: "Create",
            cancelText: "Cancel");

        if (isNewConfirmed == true)
        {
            this.files.Clear();
            VirtualFile newFile = new(DefaultFileName);
            this.files.Add(newFile);
            this.activeFileName = newFile.Name;
            await this.monacoEditor!.SetValue(string.Empty);
            this.StateHasChanged();
        }
    }

    /// <summary>
    /// Opens a file picker dialog and if the user selects a file loads it into a new tab.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task OpenFileAsync()
    {
        JsonElement? result = await this.JSRuntime.InvokeAsync<JsonElement?>("topsyTurvy.openFile");
        if (result is null || result.Value.ValueKind == JsonValueKind.Null)
        {
            return;
        }

        string name = result.Value.GetProperty("name").GetString()!;
        string content = result.Value.GetProperty("content").GetString()!;

        if (this.files.Any(file => file.Name == name))
        {
            bool? replace = await this.DialogService.ShowMessageBoxAsync(
                "File Already Open",
                $"'{name}' is already open.  Replace its content?",
                yesText: "Replace",
                cancelText: "Cancel");

            if (replace != true)
            {
                return;
            }

            VirtualFile existingFile = this.files.First(file => file.Name == name);
            existingFile.Content = content;
            if (this.activeFileName == name)
            {
                await this.monacoEditor!.SetValue(content);
            }
            else
            {
                await this.SwitchFileAsync(name);
            }

            return;
        }

        this.files.Add(new(name, content));
        await this.SwitchFileAsync(name);
        this.StateHasChanged();
    }

    /// <summary>
    /// Saves all open files as a ZIP archive and triggers a browser download.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task SaveFileAsync()
    {
        await this.SyncActiveFileContentAsync();

        using MemoryStream memoryStream = new();
        using (ZipArchive zipArchive = new(memoryStream, ZipArchiveMode.Create, leaveOpen: true))
        {
            foreach (VirtualFile file in this.files)
            {
                ZipArchiveEntry entry = zipArchive.CreateEntry(file.Name);
                using StreamWriter writer = new(entry.Open());
                writer.Write(file.Content);
            }
        }

        string streamBase64 = Convert.ToBase64String(memoryStream.ToArray());
        await this.JSRuntime.InvokeVoidAsync("topsyTurvy.downloadZip", "programme.zip", streamBase64);
    }

    /// <summary>
    /// Asks the user to confirm clearing the terminal output, and if confirmed, clears the terminal.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task ConfirmClearAsync()
    {
        bool? isClearConfirmed = await this.DialogService.ShowMessageBoxAsync(
            "Clear Terminal Output",
            "Are you sure you want to clear the terminal output?",
            yesText: "Clear",
            cancelText: "Cancel");

        if (isClearConfirmed == true)
        {
            await this.terminal!.Clear();
            this.lastRunOutput = string.Empty;
        }
    }

    /// <summary>
    /// Triggers a download of the terminal output as a text file, if there is any output to download.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task DownloadTerminalAsync()
    {
        if (!string.IsNullOrWhiteSpace(this.lastRunOutput))
        {
            await this.JSRuntime.InvokeVoidAsync("topsyTurvy.downloadText", "output.txt", this.lastRunOutput);
        }
    }

    /// <summary>
    /// Opens the new file dialog and if confirmed adds the file as a new tab.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task NewFileAsync()
    {
        IDialogReference dialog = await this.DialogService.ShowAsync<NewFileDialog>("Create New File");
        DialogResult? result = await dialog.Result;

        if (result is { Canceled: false, Data: string newName })
        {
            if (this.files.Any(file => file.Name == newName))
            {
                await this.DialogService.ShowMessageBoxAsync(
                    "File Already Exists",
                    $"A file named '{newName}' is already open.",
                    yesText: "OK");

                return;
            }

            this.files.Add(new(newName));
            await this.SwitchFileAsync(newName);
            this.StateHasChanged();
        }
    }

    /// <summary>
    /// Switches the active tab to the file with the given name saving the current file content first.
    /// </summary>
    /// <param name="name">The filename to switch to.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task SwitchFileAsync(string name)
    {
        await this.SyncActiveFileContentAsync();
        this.activeFileName = name;
        VirtualFile newFile = this.files.First(file => file.Name == name);
        await this.monacoEditor!.SetValue(newFile.Content);
        this.StateHasChanged();
    }

    /// <summary>
    /// Confirms with the user then closes the tab for the given file.
    /// </summary>
    /// <param name="name">The filename of the tab to close.</param>
    /// <remarks>
    /// If the file was the last tab open, a fresh file is created automatically.
    /// </remarks>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task CloseFileAsync(string name)
    {
        bool? isConfirmed = await this.DialogService.ShowMessageBoxAsync(
            "Close File",
            $"Close '{name}'?  Unsaved changes will be lost.",
            yesText: "Close",
            cancelText: "Cancel");

        if (isConfirmed != true)
        {
            return;
        }

        bool wasActive = this.activeFileName == name;
        int index = this.files.FindIndex(file => file.Name == name);
        this.files.RemoveAt(index);

        if (this.files.Count == 0)
        {
            VirtualFile replacement = new(DefaultFileName);
            this.files.Add(replacement);
            this.activeFileName = replacement.Name;
            await this.monacoEditor!.SetValue(string.Empty);
        }
        else if (wasActive)
        {
            int newIndex = Math.Min(index, this.files.Count - 1);
            this.activeFileName = this.files[newIndex].Name;
            await this.monacoEditor!.SetValue(this.files[newIndex].Content);
        }

        this.StateHasChanged();
    }

    /// <summary>
    /// Reads the current editor content and stores it in the active <see cref="VirtualFile"/>.
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task SyncActiveFileContentAsync()
    {
        VirtualFile? activeFile = this.files.Find(file => file.Name == this.activeFileName);
        if (activeFile is not null)
        {
            activeFile.Content = await this.JSRuntime.InvokeAsync<string>(
                "blazorMonaco.editor.getValue", "topsy-turvy-editor", false, null);
        }
    }
}
